---
interface Props {
  lang?: string;
  section?: string;
}

const { lang = 'vi', section } = Astro.props;

const translations = {
  vi: {
    title: "Sắp Ra Mắt",
    subtitle: "Nội dung đang được cập nhật",
    description: "Chúng tôi đang nỗ lực hoàn thiện thông tin chi tiết cho phần này để mang lại trải nghiệm tốt nhất cho bạn. Vui lòng quay lại sau.",
    back: "Quay lại trang chủ",
    contact: "Cần hỗ trợ ngay? Liên hệ với chúng tôi",
    phone: "+84-0941119752"
  },
  ko: {
    title: "공사 중",
    subtitle: "콘텐츠 업데이트 중입니다",
    description: "더 나은 서비스를 제공하기 위해 현재 페이지를 준비 중입니다. 잠시 후 다시 방문해 주세요.",
    back: "홈으로 돌아가기",
    contact: "도움이 필요하신가요? 문의하기",
    phone: "+82-2-3497-1970"
  }
};

const t = translations[lang as keyof typeof translations] || translations.vi;
---

<section class="min-h-[70vh] flex items-center justify-center bg-white px-6 py-24 relative overflow-hidden">
  {/* Background Decorative Elements */}
  <div class="absolute top-0 right-0 w-96 h-96 bg-blue-50 rounded-full blur-3xl opacity-50 -mr-48 -mt-48"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-orange-50 rounded-full blur-3xl opacity-30 -ml-48 -mb-48"></div>
  
  <div class="max-w-3xl w-full text-center relative z-10">
    <div class="inline-block p-4 bg-[#003366]/5 rounded-2xl mb-8 animate-pulse">
      <svg class="w-12 h-12 text-[#003366]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
      </svg>
    </div>

    <h1 class="text-5xl md:text-7xl font-black text-[#003366] tracking-tighter uppercase mb-6 leading-none not-italic">
      {t.title}
    </h1>
    
    <p class="text-xl md:text-2xl font-bold text-gray-900 mb-8 tracking-tight">
      {section ? `${section} · ` : ''}{t.subtitle}
    </p>
    
    <p class="text-gray-500 text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mb-16 font-medium">
      {t.description}
    </p>

    <div class="flex flex-col sm:flex-row gap-6 justify-center items-center">
      <a 
        href={`/${lang}/`} 
        class="px-10 py-4 bg-[#003366] text-white font-black uppercase text-xs tracking-widest rounded-xl hover:bg-[#ee5931] hover:shadow-xl transition-all active:scale-95 shadow-md"
      >
        {t.back}
      </a>
      
      <div class="flex flex-col items-center sm:items-start">
        <span class="text-[10px] font-black uppercase tracking-widest text-gray-400 mb-1">{t.contact}</span>
        <a href={`tel:${t.phone.replace(/\+/g, '')}`} class="text-lg font-black text-[#111] hover:text-[#ee5931] transition-colors">
          {t.phone}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  section {
    background-image: radial-gradient(#00336605 1px, transparent 1px);
    background-size: 40px 40px;
  }
</style>
