---
interface Props {
  data: {
    title: string;
    name: string;
    quote: string;
    bio: string;
    btnText: string;
    btnLink: string;
    image: string;
  };
}

const { data } = Astro.props;
---

<section class="py-24 bg-white">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
    <div class="flex flex-col md:flex-row items-start gap-12 lg:gap-20">
      
      <div class="w-full md:w-1/3 lg:w-1/4 flex-shrink-0">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl aspect-[3/4] border-4 border-white ring-1 ring-gray-100">
          <img 
            src={data.image} 
            alt={data.name} 
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            onerror="this.src='/images/placeholder.jpg'"
          />
          <div class="absolute bottom-0 left-0 w-full h-1/3 bg-gradient-to-t from-black/60 to-transparent"></div>
        </div>
      </div>

      <div class="w-full md:w-2/3 lg:w-3/4 pt-4">
        
        <div class="mb-8 border-b border-gray-100 pb-6">
          <span class="block text-orange-600 font-bold text-sm uppercase tracking-wider mb-2">
            {data.title}
          </span>
          <h2 class="text-4xl lg:text-5xl font-black text-gray-900 leading-tight">
            {data.name}
          </h2>
        </div>

        <blockquote class="mb-8 border-l-4 border-orange-500 pl-6 py-3 bg-orange-50 rounded-r-lg">
          <p class="text-xl font-medium italic text-gray-800 leading-relaxed tracking-wide">
            "{data.quote}"
          </p>
        </blockquote>

        <div class="prose prose-lg text-gray-600 mb-10 leading-loose text-justify">
          <p>{data.bio}</p>
        </div>

        <a 
          href={data.btnLink} 
          class="inline-flex items-center gap-3 px-8 py-4 bg-[#002a5c] text-white font-bold rounded-lg hover:bg-orange-600 transition-all duration-300 shadow-lg group"
        >
          {data.btnText}
          <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

      </div>

    </div>
  </div>
</section>