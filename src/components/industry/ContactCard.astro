---
// src/components/industry/ContactCard.astro
interface Props {
  name: string;
  position: string;
  team: string;
  phone: string;
  email: string;
}

const { name, position, team, phone, email } = Astro.props;
---

<section class="bg-gray-50 py-16">
  <div class="max-w-4xl mx-auto px-6">
    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-8 flex flex-col md:flex-row items-center gap-8 hover:shadow-md transition-shadow">
      
      <div class="w-24 h-24 bg-blue-50 rounded-full flex items-center justify-center flex-shrink-0 text-[#002a5c]">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd" />
        </svg>
      </div>

      <div class="flex-1 text-center md:text-left">
        <p class="text-sm text-gray-500 font-semibold tracking-wide uppercase">{team}</p>
        <h3 class="text-2xl font-bold text-gray-900 mt-1">{name} <span class="text-base font-normal text-gray-500">({position})</span></h3>
        
        <div class="mt-4 flex flex-col md:flex-row gap-4 justify-center md:justify-start">
          <a href={`tel:${phone}`} class="flex items-center gap-2 text-gray-600 hover:text-orange-600 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            {phone}
          </a>
          <a href={`mailto:${email}`} class="flex items-center gap-2 text-gray-600 hover:text-orange-600 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
            {email}
          </a>
        </div>
      </div>

      <div>
        <a href={`mailto:${email}`} class="px-6 py-3 border border-[#002a5c] text-[#002a5c] font-bold rounded-lg hover:bg-[#002a5c] hover:text-white transition-all">
          Contact Us
        </a>
      </div>
    </div>
  </div>
</section>