---
// src/components/QuickMenu.astro
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="fixed right-6 top-1/2 -translate-y-1/2 z-[100] hidden xl:flex flex-col gap-2">
  <a href="#" class="group relative flex items-center justify-center w-14 h-14 bg-[#003366] text-white shadow-xl hover:w-40 transition-all duration-300 rounded-l-full overflow-hidden">
    <div class="absolute right-4">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
    </div>
    <span class="absolute right-14 opacity-0 group-hover:opacity-100 whitespace-nowrap font-bold text-sm uppercase">Online Consulting</span>
  </a>

  <a href="#" class="group relative flex items-center justify-center w-14 h-14 bg-[#ee5931] text-white shadow-xl hover:w-40 transition-all duration-300 rounded-l-full overflow-hidden">
    <div class="absolute right-4">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    </div>
    <span class="absolute right-14 opacity-0 group-hover:opacity-100 whitespace-nowrap font-bold text-sm uppercase">Investment Guide</span>
  </a>

  <button id="to-top" class="w-14 h-14 bg-white border border-gray-200 text-gray-400 shadow-xl flex items-center justify-center hover:text-[#003366] transition-colors">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="3" d="M5 15l7-7 7 7"/></svg>
  </button>
</div>

<script>
  // Xử lý nút quay lại đầu trang
  const toTopBtn = document.getElementById('to-top');
  toTopBtn?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>