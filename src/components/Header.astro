---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { pathname } = Astro.url;

// Logic nhận diện trang hiện tại để đổi màu (Active State)
const currentPath = pathname.split('/')[2] || '';

// Hàm đổi ngôn ngữ luôn trả về trang chủ của ngôn ngữ đích để tránh lỗi 404
const getPath = (target: string) => {
  return `/${target}/`;
};

const menuKeys = ['why', 'industries', 'incentives', 'regions', 'services', 'about'];

/**
 * CẤU TRÚC SUBMENUS CHUẨN:
 * Đảm bảo các href trỏ đúng đến trang chi tiết để click là chuyển trang ngay.
 */
const subMenus = {
  why: [
    { key: 'why.biz', href: `/${lang}/why-korea/economy` },
    { key: 'why.fundamental', href: `/${lang}/why-korea/fundamental` },
    { key: 'why.sustainable', href: `/${lang}/why-korea/sustainable` },
    { key: 'why.stories', href: `/${lang}/why-korea/stories` },
  ],
  industries: [
    { key: 'ind.news', href: `/${lang}/industries-news` },
    ...['aerospace', 'battery', 'creative', 'finance', 'ict', 'machinery', 'energy', 'semiconductor', 'tourism', 'startup', 'automotive', 'consumer', 'display', 'chemical', 'logistics', 'bio', 'robot', 'shipbuilding'].map(k => ({ 
      key: `ind.${k}`, 
      href: `/${lang}/industries/${k}` 
    }))
  ],
  incentives: [ 
    { key: 'inc.policy', href: `/${lang}/news/policy-trends` },
    { key: 'inc.title', href: `/${lang}/incentives/` }
  ],
  regions: [
    ...['seoul', 'daejeon', 'daegu', 'ulsan', 'busan', 'gwangju', 'incheon'].map(k => ({ 
      key: `reg.${k}`, 
      href: `/${lang}/regions/${k}` 
    })),
    { key: 'reg.report', href: `/${lang}/regions/invest-report` }
  ],
  services: [
    ...['guide', 'consulting', 'living', 'faq'].map(k => ({ 
      key: `ser.${k}`, 
      href: `/${lang}/services/${k}` 
    }))
  ],
  about: [
    { key: 'abt.about', href: `/${lang}/about/info` },
    { key: 'abt.message', href: `/${lang}/about/message` },
    { key: 'abt.media', href: `/${lang}/about/media` },
  ]
};
---

<div class="w-full bg-[#002a5c] py-2 relative z-[60]">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center text-[11px] text-white font-bold uppercase tracking-widest">
    <span>{t('nav.kotra')}</span>
    <a href="#" class="hover:underline">{t('nav.summit')}</a>
  </div>
</div>

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50 h-[80px] flex items-center shadow-sm transition-all" id="main-header">
  <div class="max-w-7xl mx-auto px-4 w-full flex justify-between items-center h-full relative text-left">
    
    <a href={`/${lang}/`} class="text-2xl font-black text-[#003366] tracking-tighter z-50">Invest KOREA</a>

    <nav class="hidden lg:flex items-center gap-8 h-full">
      {menuKeys.map(key => {
        // Đồng bộ hóa tên path cho Why Korea
        const isActive = currentPath === (key === 'why' ? 'why-korea' : key);

        return (
          <div class="relative group h-full flex items-center nav-item">
            
            <a href={`/${lang}/${key === 'why' ? 'why-korea' : key}/`} 
               class={`text-[14px] font-bold uppercase py-8 transition-colors block h-full flex items-center ${isActive ? 'text-[#003366]' : 'text-[#111] hover:text-[#003366]'}`}>
              {t(`nav.${key}`)}
            </a>

            <span class={`absolute bottom-0 left-0 w-full h-[3px] bg-[#003366] transition-transform duration-300 origin-left ${isActive ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100'}`}></span>

            <div class="megamenu-panel fixed top-[80px] left-0 w-full bg-white border-t border-gray-200 shadow-2xl hidden z-40 animate-in fade-in slide-in-from-top-1 duration-200">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                
                <div class="w-1/3 border-r border-gray-100 pr-10 flex items-center">
                  <h2 class="text-[52px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {key === 'why' ? t('why.title') : t(`nav.${key}`)}
                  </h2>
                </div>

                <div class="w-2/3 grid grid-cols-2 gap-x-20 gap-y-4 pl-24 pt-4">
                  {(subMenus[key as keyof typeof subMenus] || []).map(sub => (
                    <a href={sub.href} class="text-[17px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors flex items-center gap-2 group/sub">
                      <span class="w-0 h-px bg-[#ee5931] transition-all group-hover/sub:w-4"></span>
                      {t(sub.key)}
                    </a>
                  ))}
                </div>

              </div>
            </div>
          </div>
        );
      })}
    </nav>

    <div class="flex items-center gap-1 sm:gap-2 md:gap-4 z-[70]">
      <div class="hidden lg:flex items-center bg-gray-100 rounded-full p-1 border border-gray-200 font-bold">
        <a href={getPath('vi')} class={`px-4 py-1 text-[11px] rounded-full transition-all ${lang === 'vi' ? 'bg-[#003366] text-white shadow-md' : 'text-gray-400 hover:text-gray-600'}`}>VN</a>
        <a href={getPath('ko')} class={`px-4 py-1 text-[11px] rounded-full transition-all ${lang === 'ko' ? 'bg-[#003366] text-white shadow-md' : 'text-gray-400 hover:text-gray-600'}`}>KO</a>
      </div>
      
      <button id="btn-search-open" class="p-1.5 sm:p-2 text-gray-600 hover:text-[#003366] transition-colors">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </button>

      <!-- Mobile Menu Toggle -->
      <button id="btn-mobile-menu" class="lg:hidden p-1.5 sm:p-2 text-gray-900 hover:text-[#003366] transition-colors relative" aria-label="Toggle Menu">
        <svg id="hamburger-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer Overlay -->
  <div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 z-[100] hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm lg:hidden"></div>

  <!-- Mobile Menu Drawer Content -->
  <div id="mobile-menu-drawer" class="fixed top-0 right-0 h-full w-[280px] sm:w-[320px] bg-white z-[110] translate-x-full transition-transform duration-300 ease-in-out shadow-[-10px_0_30px_rgba(0,0,0,0.1)] lg:hidden flex flex-col">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-white sticky top-0 z-10">
      <span class="text-xl font-black text-[#003366] tracking-tighter">Invest KOREA</span>
      <button id="btn-mobile-close" class="p-2 text-gray-400 hover:text-red-500 transition-colors">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Mobile Language Selector -->
    <div class="px-5 py-4 bg-gray-50 flex items-center justify-center gap-2 border-b border-gray-100">
        <a href={getPath('vi')} class={`flex-1 text-center py-2.5 text-[11px] font-bold rounded-lg transition-all ${lang === 'vi' ? 'bg-[#003366] text-white shadow-lg' : 'bg-white text-gray-400 border border-gray-200'}`}>VIETNAM</a>
        <a href={getPath('ko')} class={`flex-1 text-center py-2.5 text-[11px] font-bold rounded-lg transition-all ${lang === 'ko' ? 'bg-[#003366] text-white shadow-lg' : 'bg-white text-gray-400 border border-gray-200'}`}>KOREA</a>
    </div>

    <div class="flex-1 overflow-y-auto py-2">
      {menuKeys.map(key => (
        <div class="mobile-nav-item border-b border-gray-50 last:border-0">
          <button class="w-full flex justify-between items-center px-6 py-4 text-[14px] font-bold text-gray-900 hover:bg-gray-50 transition-colors group mobile-accordion-toggle">
            {t(`nav.${key}`)}
            <svg class="transition-transform duration-300 group-[.active]:rotate-180 text-gray-400" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="mobile-submenu hidden bg-gray-50 border-t border-gray-100 animate-in fade-in slide-in-from-top-1 duration-200">
            {(subMenus[key as keyof typeof subMenus] || []).map(sub => (
              <a href={sub.href} class="block py-4 px-10 text-[13px] text-gray-600 hover:text-[#003366] font-semibold border-b border-gray-100 last:border-0">
                {t(sub.key)}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="p-6 bg-white border-t border-gray-100 sticky bottom-0">
        <a href="#" class="block w-full bg-[#ee5931] text-white text-center py-4 rounded-xl font-bold text-xs tracking-widest uppercase hover:bg-[#d44d28] transition-all shadow-lg active:scale-95">
            {t('nav.summit')}
        </a>
    </div>
  </div>
</header>
<script>
  function initHeader() {
    const menus = document.querySelectorAll('.megamenu-panel');
    const navItems = document.querySelectorAll('.nav-item');
    const topBar = document.querySelector('div.w-full.bg-\\[\\#002a5c\\]') as HTMLElement;
    const topBarHeight = topBar ? topBar.offsetHeight : 0;

    let closeTimeout: any = null;

    // Mobile Menu elements
    const btnMobileMenu = document.getElementById('btn-mobile-menu');
    const btnMobileClose = document.getElementById('btn-mobile-close');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    const accordionToggles = document.querySelectorAll('.mobile-accordion-toggle');

    function toggleMobileMenu(isOpen: boolean) {
      if (isOpen) {
        mobileOverlay?.classList.remove('hidden');
        setTimeout(() => {
          mobileOverlay?.classList.add('opacity-100');
          mobileDrawer?.classList.remove('translate-x-full');
        }, 10);
        document.body.style.overflow = 'hidden';
      } else {
        mobileOverlay?.classList.remove('opacity-100');
        mobileDrawer?.classList.add('translate-x-full');
        document.body.style.overflow = '';
        setTimeout(() => {
          mobileOverlay?.classList.add('hidden');
        }, 300);
      }
    }

    btnMobileMenu?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleMobileMenu(true);
    });
    btnMobileClose?.addEventListener('click', () => toggleMobileMenu(false));
    mobileOverlay?.addEventListener('click', () => toggleMobileMenu(false));

    accordionToggles.forEach(toggle => {
        toggle.addEventListener('click', () => {
            const submenu = toggle.nextElementSibling;
            
            // Close other accordions
            accordionToggles.forEach(other => {
                if (other !== toggle) {
                    other.classList.remove('active');
                    other.nextElementSibling?.classList.add('hidden');
                }
            });

            toggle.classList.toggle('active');
            submenu?.classList.toggle('hidden');
        });
    });

    function updateMenuTop() {
      const scrollTop = window.scrollY;
      const topValue = scrollTop >= topBarHeight ? '80px' : `${80 + topBarHeight}px`;
      menus.forEach(menu => {
        (menu as HTMLElement).style.top = topValue;
      });
    }

    // Initial update
    updateMenuTop();

    window.addEventListener('scroll', () => {
      menus.forEach(m => { (m as HTMLElement).classList.add('hidden'); });
      updateMenuTop();
    }, { passive: true });

    navItems.forEach(item => {
      const menu = item.querySelector('.megamenu-panel') as HTMLElement;
      
      item.addEventListener('mouseenter', () => {
        if (closeTimeout) clearTimeout(closeTimeout);
        
        // Close others immediately
        menus.forEach(m => {
          if (m !== menu) (m as HTMLElement).classList.add('hidden');
        });

        if (menu) {
          menu.classList.remove('hidden');
          updateMenuTop();
        }
      });

      item.addEventListener('mouseleave', () => {
        closeTimeout = setTimeout(() => {
          if (menu) menu.classList.add('hidden');
        }, 300); // 300ms grace period
      });
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('DOMContentLoaded', initHeader);
</script>

<style>
  header * { font-style: normal !important; letter-spacing: -0.01em; }

  /* Bridge to prevent hover gap issues */
  .megamenu-panel::before {
    content: '';
    position: absolute;
    top: -20px;
    left: 0;
    width: 100%;
    height: 20px;
    background: transparent;
  }
  
  /* Custom Scrollbar for Drawer */
  #mobile-menu-drawer div::-webkit-scrollbar {
    width: 4px;
  }
  #mobile-menu-drawer div::-webkit-scrollbar-thumb {
    background: #e5e7eb;
    border-radius: 10px;
  }

  @media (max-width: 1023px) {
    body {
       overflow-x: hidden;
       width: 100%;
       position: relative;
    }
  }
</style>