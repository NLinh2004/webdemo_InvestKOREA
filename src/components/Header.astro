---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---
<div class="w-full bg-[#002a5c] py-2">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center text-[11px] text-white font-bold uppercase">
    <span>{t('nav.kotra')}</span>
    <a href="#" class="hover:underline">{t('nav.summit')}</a>
  </div>
</div>

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50 h-[80px] flex items-center shadow-sm">
  <div class="max-w-7xl mx-auto px-4 w-full flex justify-between items-center">
    <a href={`/${lang}/`} class="text-2xl font-black text-[#003366] tracking-tighter italic">Invest KOREA</a>

    <nav class="hidden lg:flex items-center gap-8 h-full">
      {/* Thêm 'regions' vào mảng để hiển thị trên thanh menu */}
      {['why', 'industries', 'incentives', 'regions', 'services', 'about'].map(key => (
        <div class="relative group h-full flex items-center">
          <a href={['why', 'industries', 'incentives', 'regions'].includes(key) ? `/${lang}/${key}/` : "#"} 
             class="text-[14px] font-bold text-[#111] hover:text-[#003366] uppercase py-8">
            {t(`nav.${key}`)}
          </a>

          {/* MEGA MENU: WHY KOREA */}
          {key === 'why' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-20 px-6">
                <div class="w-1/3 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    Why <br/> KOREA
                  </h2>
                </div>
                <div class="w-2/3 grid grid-cols-2 gap-x-20 gap-y-12 pl-24 pt-4">
                  <div class="flex flex-col gap-5">
                    <a href={`/${lang}/why#biz`} class="text-[18px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('why.biz')}</a>
                    <a href={`/${lang}/why#sustainable`} class="text-[18px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('why.sustainable')}</a>
                  </div>
                  <div class="flex flex-col gap-5">
                    <a href={`/${lang}/why#fundamental`} class="text-[18px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('why.fundamental')}</a>
                    <a href={`/${lang}/why#stories`} class="text-[18px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('why.stories')}</a>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* MEGA MENU: INDUSTRIES */}
          {key === 'industries' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[48px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    Industries
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16">
                  <div class="flex flex-col gap-3">
                    {['news', 'aerospace', 'battery', 'creative', 'finance', 'ict', 'machinery', 'energy', 'semiconductor', 'tourism'].map(ind => (
                      <a href="#" class="text-[15px] font-medium text-gray-700 hover:text-[#ee5931] hover:font-bold transition-all">{t(`ind.${ind}`)}</a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-3">
                    {['startup', 'automotive', 'consumer', 'display', 'chemical', 'logistics', 'bio', 'robot', 'shipbuilding'].map(ind => (
                      <a href="#" class="text-[15px] font-medium text-gray-700 hover:text-[#ee5931] hover:font-bold transition-all">{t(`ind.${ind}`)}</a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )} 

          {/* MEGA MENU: INCENTIVES */}
          {key === 'incentives' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-24 px-6">
                <div class="w-1/3 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    Incentives
                  </h2>
                </div>
                <div class="w-2/3 pl-20 pt-4">
                  <a href={`/${lang}/incentives/`} class="text-[18px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('inc.policy')}</a>
                </div>
              </div>
            </div>
          )} 

          {/* MEGA MENU: REGIONS */}
          {key === 'regions' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    Regions
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-20 pl-20 pt-4">
                  <div class="flex flex-col gap-3">
                    {['seoul', 'gyeonggi', 'daejeon', 'chungbuk', 'daegu', 'ulsan', 'gyeongnam', 'jeonbuk', 'jeju'].map(reg => (
                      <a href="#" class="text-[15px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t(`reg.${reg}`)}</a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-3">
                    {['incheon', 'gangwon', 'sejong', 'chungnam', 'busan', 'gyeongbuk', 'gwangju', 'jeonnam', 'report'].map(reg => (
                      <a href="#" class={`text-[15px] font-bold hover:text-[#ee5931] transition-colors ${reg === 'report' ? 'text-[#003366] mt-4 underline' : 'text-gray-800'}`}>
                        {t(`reg.${reg}`)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )} 
          {key === 'services' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                {/* Tiêu đề bên trái */}
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    Services
                  </h2>
                </div>

                {/* Danh sách 2 cột bên phải */}
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16 pt-4">
                  <div class="flex flex-col gap-4">
                    {['guide', 'consulting', 'living', 'cost', 'legislation'].map(item => (
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">
                        {t(`ser.${item}`)}
                      </a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-4">
                    {['faq', 'office', 'network', 'forms'].map(item => (
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">
                        {t(`ser.${item}`)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}  
          {key === 'about' && (
            <div class="fixed top-[112px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                {/* Tiêu đề bên trái */}
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black italic uppercase tracking-tighter text-[#111] leading-none">
                    About Us
                  </h2>
                </div>

                {/* Danh sách các cột bên phải */}
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16 pt-4">
                  <div class="flex flex-col gap-6">
                    <div class="flex flex-col gap-3">
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.message')}</a>
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.ombudsman')}</a>
                    </div>
                    <div class="flex flex-col gap-3 mt-4">
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.publication')}</a>
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.video')}</a>
                    </div>
                  </div>
                  <div class="flex flex-col gap-6">
                    <div class="flex flex-col gap-3">
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.about')}</a>
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.honorary')}</a>
                    </div>
                    <div class="flex flex-col gap-3 mt-4">
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.magazine')}</a>
                      <a href="#" class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">{t('abt.media')}</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          )}     
        </div>
      ))}
    </nav>

    {/* Nút chuyển đổi ngôn ngữ */}
    <div class="flex items-center bg-gray-100 rounded-full p-1 border border-gray-200">
      <a href="/vi/" class={`px-4 py-1 text-[11px] font-bold rounded-full ${lang === 'vi' ? 'bg-[#003366] text-white' : 'text-gray-400 hover:text-gray-600'}`}>VN</a>
      <a href="/ko/" class={`px-4 py-1 text-[11px] font-bold rounded-full ${lang === 'ko' ? 'bg-[#003366] text-white' : 'text-gray-400 hover:text-gray-600'}`}>KO</a>
    </div>
  </div>
</header>