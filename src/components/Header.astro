---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { pathname } = Astro.url;
const getPath = (target: string) => {
  const segments = pathname.split('/');
  // Xử lý trường hợp trang chủ hoặc trang con
  if (segments[1] === 'vi' || segments[1] === 'ko') {
    segments[1] = target;
  } else {
    return `/${target}${pathname}`;
  }
  return segments.join('/');
};

// Danh sách các mục menu chính
const menuKeys = ['why', 'industries', 'incentives', 'regions', 'services', 'about'];

// --- DỮ LIỆU MENU CON CHO MOBILE ---
// Được tổng hợp từ các phần Mega Menu trên Desktop
const subMenus = {
  why: [
    { key: 'why.biz', href: `/${lang}/why#biz` },
    { key: 'why.sustainable', href: `/${lang}/why#sustainable` },
    { key: 'why.fundamental', href: `/${lang}/why#fundamental` },
    { key: 'why.stories', href: `/${lang}/why#stories` },
  ],
  industries: [
    // Gộp 2 cột của desktop thành 1 danh sách dọc
    ...['news', 'aerospace', 'battery', 'creative', 'finance', 'ict', 'machinery', 'energy', 'semiconductor', 'tourism', 'startup', 'automotive', 'consumer', 'display', 'chemical', 'logistics', 'bio', 'robot', 'shipbuilding'].map(k => ({ key: `ind.${k}`, href: `/${lang}/industries/${k}` }))
  ],
  incentives: [
    { key: 'inc.policy', href: `/${lang}/incentives/` }
  ],
  regions: [
    // Gộp tất cả khu vực
    ...['seoul', 'gyeonggi', 'daejeon', 'chungbuk', 'daegu', 'ulsan', 'gyeongnam', 'jeonbuk', 'jeju', 'incheon', 'gangwon', 'sejong', 'chungnam', 'busan', 'gyeongbuk', 'gwangju', 'jeonnam'].map(k => ({ key: `reg.${k}`, href: `/${lang}/regions/${k}` })),
    { key: 'reg.report', href: `/${lang}/regions/invest-report` }
  ],
  services: [
    ...['guide', 'consulting', 'living', 'cost', 'legislation', 'faq', 'office', 'network', 'forms'].map(k => ({ key: `ser.${k}`, href: `/${lang}/services/${k}` }))
  ],
  about: [
    { key: 'abt.message', href: `/${lang}/about/message` },
    { key: 'abt.ombudsman', href: `/${lang}/about/ombudsman` },
    { key: 'abt.publication', href: `/${lang}/about/publication` },
    { key: 'abt.video', href: `/${lang}/about/video` },
    { key: 'abt.about', href: `/${lang}/about/info` },
    { key: 'abt.honorary', href: `/${lang}/about/honorary` },
    { key: 'abt.magazine', href: `/${lang}/about/magazine` },
    { key: 'abt.media', href: `/${lang}/about/media` },
  ]
};
---

<div class="w-full bg-[#002a5c] py-2 relative z-[60]">
  <div class="max-w-7xl mx-auto px-4 flex justify-between items-center text-[11px] text-white font-bold uppercase tracking-widest">
    <span>{t('nav.kotra')}</span>
    <a href="#" class="hover:underline">{t('nav.summit')}</a>
  </div>
</div>

<header class="w-full bg-white border-b border-gray-100 sticky top-0 z-50 h-[80px] flex items-center shadow-sm text-left transition-all" id="main-header">
  <div class="max-w-7xl mx-auto px-4 w-full flex justify-between items-center h-full">
    
    <a href={`/${lang}/`} class="text-2xl font-black text-[#003366] tracking-tighter z-50">Invest KOREA</a>

    <nav class="hidden lg:flex items-center gap-8 h-full">
      {menuKeys.map(key => (
        <div class="relative group h-full flex items-center">
          
          <a href={`/${lang}/${key}/`} 
             class="text-[14px] font-bold text-[#111] hover:text-[#003366] uppercase py-8 transition-colors block h-full flex items-center">
            {t(`nav.${key}`)}
          </a>

          <span class="absolute bottom-0 left-0 w-full h-[3px] bg-[#003366] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></span>

          
          {key === 'why' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-200 shadow-2xl hidden group-hover:block z-40 animate-in fade-in slide-in-from-top-1 duration-200">
              <div class="max-w-7xl mx-auto flex py-20 px-6">
                <div class="w-1/3 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">{t('nav.why')}</h2>
                </div>
                <div class="w-2/3 grid grid-cols-2 gap-x-20 gap-y-12 pl-24 pt-4">
                  <div class="flex flex-col gap-5">
                    <a href={`/${lang}/why#biz`} class="text-[18px] font-bold text-gray-900 hover:text-[#ee5931]">{t('why.biz')}</a>
                    <a href={`/${lang}/why#sustainable`} class="text-[18px] font-bold text-gray-900 hover:text-[#ee5931]">{t('why.sustainable')}</a>
                  </div>
                  <div class="flex flex-col gap-5">
                    <a href={`/${lang}/why#fundamental`} class="text-[18px] font-bold text-gray-900 hover:text-[#ee5931]">{t('why.fundamental')}</a>
                    <a href={`/${lang}/why#stories`} class="text-[18px] font-bold text-gray-900 hover:text-[#ee5931]">{t('why.stories')}</a>
                  </div>
                </div>
              </div>
            </div>
          )}
          {key === 'industries' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[48px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {t('ind.title')}
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16">
                  <div class="flex flex-col gap-3">
                    {['news', 'aerospace', 'battery', 'creative', 'finance', 'ict', 'machinery', 'energy', 'semiconductor', 'tourism'].map(ind => (
                      <a href={`/${lang}/industries/${ind}`} class="text-[15px] font-bold text-gray-800 hover:text-[#ee5931] transition-all">
                        {t(`ind.${ind}`)}
                      </a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-3">
                    {['startup', 'automotive', 'consumer', 'display', 'chemical', 'logistics', 'bio', 'robot', 'shipbuilding'].map(ind => (
                      <a href={`/${lang}/industries/${ind}`} class="text-[15px] font-bold text-gray-800 hover:text-[#ee5931] transition-all">
                        {t(`ind.${ind}`)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}
          {key === 'incentives' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-24 px-6">
                <div class="w-1/3 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {t('nav.incentives')}
                  </h2>
                </div>
                <div class="w-2/3 pl-20 pt-4">
                  <a href={`/${lang}/incentives/`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">
                    {t('inc.policy')}
                  </a>
                </div>
              </div>
            </div>
          )}
          {key === 'regions' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {t('nav.regions')}
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-20 pl-20 pt-4">
                  <div class="flex flex-col gap-3">
                    {['seoul', 'gyeonggi', 'daejeon', 'chungbuk', 'daegu', 'ulsan', 'gyeongnam', 'jeonbuk', 'jeju'].map(reg => (
                      <a href={`/${lang}/regions/${reg}`} class="text-[15px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t(`reg.${reg}`)}</a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-3">
                    {['incheon', 'gangwon', 'sejong', 'chungnam', 'busan', 'gyeongbuk', 'gwangju', 'jeonnam', 'report'].map(reg => (
                      <a href={reg === 'report' ? `/${lang}/regions/invest-report` : `/${lang}/regions/${reg}`} class={`text-[15px] font-bold hover:text-[#ee5931] transition-colors ${reg === 'report' ? 'text-[#003366] mt-4 underline' : 'text-gray-900'}`}>
                        {t(`reg.${reg}`)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}
          {key === 'services' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {t('nav.services')}
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16 pt-4">
                  <div class="flex flex-col gap-4">
                    {['guide', 'consulting', 'living', 'cost', 'legislation'].map(item => (
                      <a href={`/${lang}/services/${item}`} class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">
                        {t(`ser.${item}`)}
                      </a>
                    ))}
                  </div>
                  <div class="flex flex-col gap-4">
                    {['faq', 'office', 'network', 'forms'].map(item => (
                      <a href={`/${lang}/services/${item}`} class="text-[16px] font-bold text-gray-800 hover:text-[#ee5931] transition-colors">
                        {t(`ser.${item}`)}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}
          {key === 'about' && (
            <div class="fixed top-[80px] left-0 w-full bg-white border-t border-gray-100 shadow-2xl hidden group-hover:block z-50">
              <div class="max-w-7xl mx-auto flex py-16 px-6">
                <div class="w-1/4 border-r border-gray-100 pr-10">
                  <h2 class="text-[56px] font-black uppercase tracking-tighter text-[#111] leading-[1.1] not-italic">
                    {t('nav.about')}
                  </h2>
                </div>
                <div class="w-3/4 grid grid-cols-2 gap-x-12 pl-16 pt-4">
                  <div class="flex flex-col gap-y-4"> 
                    <a href={`/${lang}/about/message`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.message')}</a>
                    <a href={`/${lang}/about/ombudsman`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.ombudsman')}</a>
                    <a href={`/${lang}/about/publication`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.publication')}</a>
                    <a href={`/${lang}/about/video`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.video')}</a>
                  </div>
                  <div class="flex flex-col gap-y-4">
                    <a href={`/${lang}/about/info`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.about')}</a>
                    <a href={`/${lang}/about/honorary`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.honorary')}</a>
                    <a href={`/${lang}/about/magazine`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.magazine')}</a>
                    <a href={`/${lang}/about/media`} class="text-[16px] font-bold text-gray-900 hover:text-[#ee5931] transition-colors">{t('abt.media')}</a>
                  </div>  
                </div>
              </div>
            </div>
          )} 
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-4 z-50">
      <div class="hidden md:flex items-center bg-gray-100 rounded-full p-1 border border-gray-200">
        <a href={getPath('vi')} class={`px-4 py-1 text-[11px] font-bold rounded-full transition-all ${lang === 'vi' ? 'bg-[#003366] text-white shadow-md' : 'text-gray-400 hover:text-gray-600'}`}>VN</a>
        <a href={getPath('ko')} class={`px-4 py-1 text-[11px] font-bold rounded-full transition-all ${lang === 'ko' ? 'bg-[#003366] text-white shadow-md' : 'text-gray-400 hover:text-gray-600'}`}>KO</a>
      </div>

      <button id="btn-search-open" class="p-2 text-gray-600 hover:text-[#003366] transition-colors" aria-label="Search">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <button id="btn-mobile-menu" class="lg:hidden p-2 text-[#003366] focus:outline-none" aria-label="Menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div id="search-overlay" class="fixed inset-0 bg-white/98 z-[70] translate-y-[-100%] transition-transform duration-300 ease-in-out flex flex-col justify-center items-center opacity-0 pointer-events-none data-[open=true]:translate-y-0 data-[open=true]:opacity-100 data-[open=true]:pointer-events-auto">
    <button id="btn-search-close" class="absolute top-8 right-8 p-2 text-gray-500 hover:text-[#003366]">
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
    <div class="w-full max-w-3xl px-6">
      <h3 class="text-3xl font-bold text-[#003366] mb-8 text-center uppercase tracking-tight">
        {lang === 'vi' ? 'Bạn đang tìm kiếm gì?' : '무엇을 찾고 계십니까?'}
      </h3>
      <form action={`/${lang}/search`} method="GET" class="relative">
        <input type="text" name="q" id="search-input" class="w-full bg-transparent border-b-2 border-gray-300 py-4 text-2xl text-gray-900 focus:outline-none focus:border-[#003366] placeholder-gray-300 transition-colors" placeholder={lang === 'vi' ? 'Nhập từ khóa...' : '검색어를 입력하세요...'} />
        <button type="submit" class="absolute right-0 top-4 text-[#003366]">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
        </button>
      </form>
    </div>
  </div>

  <div id="mobile-menu-overlay" class="fixed inset-0 bg-white z-[65] translate-x-full transition-transform duration-300 ease-in-out lg:hidden overflow-y-auto data-[open=true]:translate-x-0">
    <div class="p-6 pt-24">
      <button id="btn-mobile-close" class="absolute top-6 right-6 p-2 text-gray-500 hover:text-[#003366]">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>

      <nav class="flex flex-col">
        {menuKeys.map(key => {
          // Lấy danh sách con tương ứng từ biến subMenus
          const subItems = subMenus[key as keyof typeof subMenus] || [];
          const hasSub = subItems.length > 0;

          return (
            <div class="border-b border-gray-100">
              <div class="flex items-center justify-between py-4">
                <a 
                  href={`/${lang}/${key}/`} 
                  class="text-xl font-bold text-[#003366] uppercase"
                >
                  {t(`nav.${key}`)}
                </a>
                
                {/* Nút mũi tên mở rộng nếu có menu con */}
                {hasSub && (
                  <button class="mobile-accordion-btn p-2 text-gray-400 hover:text-[#ee5931] transition-colors" aria-label="Toggle submenu">
                    <svg class="w-5 h-5 transition-transform duration-300 transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </button>
                )}
              </div>

              {/* Khu vực menu con (ẩn mặc định) */}
              {hasSub && (
                <div class="mobile-submenu hidden pl-4 pb-4 space-y-3 bg-gray-50 rounded-lg mb-2">
                  {subItems.map(item => (
                    <a href={item.href} class="block text-[15px] font-medium text-gray-600 hover:text-[#ee5931] py-1">
                      {t(item.key)}
                    </a>
                  ))}
                </div>
              )}
            </div>
          );
        })}
      </nav>

      <div class="mt-12 flex gap-4">
        <a href={getPath('vi')} class={`px-6 py-2 rounded-full border border-gray-200 font-bold ${lang === 'vi' ? 'bg-[#003366] text-white' : 'text-gray-600'}`}>Tiếng Việt</a>
        <a href={getPath('ko')} class={`px-6 py-2 rounded-full border border-gray-200 font-bold ${lang === 'ko' ? 'bg-[#003366] text-white' : 'text-gray-600'}`}>한국어</a>
      </div>
    </div>
  </div>

</header>

<script>
  function initHeader() {
    // --- Mobile Menu Toggle ---
    const mobileBtn = document.getElementById('btn-mobile-menu');
    const mobileClose = document.getElementById('btn-mobile-close');
    const mobileOverlay = document.getElementById('mobile-menu-overlay');

    if (mobileBtn && mobileClose && mobileOverlay) {
      mobileBtn.onclick = () => {
        mobileOverlay.setAttribute('data-open', 'true');
        document.body.style.overflow = 'hidden';
      };
      mobileClose.onclick = () => {
        mobileOverlay.setAttribute('data-open', 'false');
        document.body.style.overflow = '';
      };
    }

    // --- Search Toggle ---
    const searchOpen = document.getElementById('btn-search-open');
    const searchClose = document.getElementById('btn-search-close');
    const searchOverlay = document.getElementById('search-overlay');
    const searchInput = document.getElementById('search-input');

    if (searchOpen && searchClose && searchOverlay) {
      searchOpen.onclick = () => {
        searchOverlay.setAttribute('data-open', 'true');
        setTimeout(() => searchInput && searchInput.focus(), 100);
      };
      searchClose.onclick = () => {
        searchOverlay.setAttribute('data-open', 'false');
      };
    }

    // --- Mobile Accordion Logic (MỚI) ---
    const accordionBtns = document.querySelectorAll('.mobile-accordion-btn');
    
    accordionBtns.forEach(btn => {
      // Xóa event cũ để tránh duplicate khi view transition chạy lại
      const newBtn = btn.cloneNode(true) as HTMLElement;
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', (e) => {
        // Tìm div submenu ngay sau phần tử cha của nút bấm
        // Cấu trúc: <div> <div class="flex..."> <a>...</a> <button>... </button> </div> <div class="submenu">...</div> </div>
        const container = newBtn.closest('div')?.parentElement ?? null;
        const submenu = container?.querySelector('.mobile-submenu');
        const icon = newBtn.querySelector('svg');

        if (submenu) {
          submenu.classList.toggle('hidden');
          icon?.classList.toggle('rotate-180');
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initHeader);
  document.addEventListener('DOMContentLoaded', initHeader);
</script>