---
interface Props {
  title: string;
  description: string;
  items: {
    title: string;
    icon: string;
    link: string;
  }[];
  columns?: 3 | 4;
}

const { title, description, items, columns = 3 } = Astro.props; 
// Logic chọn class dựa trên số cột
const gridClasses = columns === 4 
  ? "grid-cols-2 md:grid-cols-4" // Nếu là 4: Mobile 2 cột, PC 4 cột
  : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3"; // Mặc định: Mobile 1, Tablet 2, PC 3
---

<section class="bg-[#f8f9fa] py-24">
  <div class="container mx-auto px-6">
    
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20 text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6 tracking-tight">
        {title}
      </h2>
      <p class="text-gray-600 mb-12 max-w-3xl mx-auto text-lg leading-relaxed">
        {description}
      </p>
    </div>
    
    <div class={`grid ${gridClasses} gap-6 max-w-[1400px] mx-auto`}>
      {items.map((item) => (
        <a 
          href={item.link} 
          class="
            bg-white 
            p-8 
            h-56 
            rounded-2xl 
            border border-gray-100 
            shadow-sm hover:shadow-xl 
            flex flex-col justify-between 
            hover:bg-[#003366] 
            transition-all duration-300 
            group relative overflow-hidden
          "
        >
          <div class="mb-4">
            <span class="text-4xl text-gray-400 group-hover:text-white transition-colors duration-300 filter group-hover:brightness-200">
              {item.icon}
            </span>
          </div>

          <div class="flex justify-between items-end border-t border-transparent group-hover:border-white/20 pt-4 transition-all">
            <span class="text-lg font-bold text-gray-800 group-hover:text-white uppercase tracking-tight leading-snug max-w-[85%]">
              {item.title}
            </span>
            <span class="text-xl text-gray-300 group-hover:text-white group-hover:translate-x-2 transition-transform duration-300">
              →
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>