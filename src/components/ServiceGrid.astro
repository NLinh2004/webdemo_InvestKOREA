---
interface Props {
  title: string;
  items: {
    title: string;
    icon: string;
    link: string;
  }[];
}

const { title, items } = Astro.props;
---

<section class="bg-white py-24">
  <div class="container mx-auto px-6">
    
    <div class="max-w-[1400px] mx-auto text-left mb-16">
      <h2 class="text-4xl font-black text-[#003366] uppercase tracking-tighter leading-none">
        {title}
      </h2>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 max-w-[1400px] mx-auto border-t border-l border-gray-200">
      {items.map((item) => (
        <a 
          href={item.link} 
          class="
            bg-white 
            p-10 
            h-52 
            /* Thêm viền phải và dưới để tạo hiệu ứng lưới dính liền */
            border-r border-b border-gray-200 
            flex flex-col justify-between 
            hover:bg-[#003366] 
            transition-all duration-300 
            group relative overflow-hidden
          "
        >
          <div class="mb-4">
  <div class="text-4xl text-gray-800 group-hover:text-white transition-all duration-300">
    <Fragment set:html={item.icon} />
  </div>
</div>

          <div class="flex justify-between items-end text-left">
            <span class="text-sm font-black text-gray-700 group-hover:text-white uppercase tracking-tight leading-tight w-2/3 italic block">
              {item.title}
            </span>
            <span class="text-gray-300 group-hover:text-white group-hover:translate-x-1 transition-all text-xl">
              →
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<style>
  /* Ẩn thanh cuộn nhưng vẫn cho phép scroll */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initSlider() {
    const slider = document.getElementById('ind-slider');
    const prevBtn = document.getElementById('ind-prev');
    const nextBtn = document.getElementById('ind-next');

    if (!slider || !prevBtn || !nextBtn) return;

    nextBtn.addEventListener('click', () => {
      slider.scrollLeft += slider.offsetWidth;
    });

    prevBtn.addEventListener('click', () => {
      slider.scrollLeft -= slider.offsetWidth;
    });
  }

  // Chạy khi load trang
  document.addEventListener('astro:page-load', initSlider);
</script>

