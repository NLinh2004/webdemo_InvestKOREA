---
// src/pages/ko/why.astro
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ko';
const t = useTranslations(lang);
---

<Layout title="Why KOREA" lang={lang}>
  <main class="bg-white min-h-screen">
    <div class="border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 py-4 text-[12px] font-bold text-gray-400 uppercase">
        홈 <span class="mx-2">/</span> Why KOREA
      </div>
    </div>

    <section class="max-w-7xl mx-auto px-6 py-20 flex flex-col lg:flex-row gap-16">
      <div class="lg:w-1/3 border-r border-gray-100 pr-10">
        <h1 class="text-[60px] font-black text-[#003366] leading-[0.9] tracking-tighter uppercase italic">
          Why <br/> KOREA
        </h1>
      </div>

      <div class="lg:w-2/3 grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 pt-4">
        {['biz', 'fundamental', 'sustainable', 'stories'].map((key) => (
          <div class="group cursor-pointer">
            <h3 class="text-[20px] font-black text-gray-900 mb-2 uppercase group-hover:text-[#ee5931] transition-colors">
              {t(`why.${key}`)}
            </h3>
            <div class="w-10 h-1 bg-[#ee5931] transition-all duration-300 group-hover:w-20"></div>
          </div>
        ))}
      </div>
    </section>
  </main>
</Layout>