---
import Layout from '../../layouts/Layout.astro';
import { servicesData } from '../../i18n/_services';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import ServiceGrid from '../../components/ServiceGrid.astro';
import OfficeFinder from '../../components/OfficeFinder.astro';
import AskBanner from '../../components/AskBanner.astro';

// Lấy ngôn ngữ hiện tại
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = servicesData[lang as keyof typeof servicesData] || servicesData.ko;
const translate = useTranslations(lang);
---

<Layout title={`${t.pageTitle} - Invest KOREA`} lang={lang}>
  
  <section class="w-full">
    <div class="pt-24 pb-12 px-6 max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-8 font-bold not-italic uppercase tracking-widest">
        <a href={`/${lang}`} class="hover:text-gray-600">{translate('inc.breadcrumb_home')}</a> · <span class="text-gray-900">{t.pageTitle}</span>
      </nav>
      
      <h1 class="text-[80px] font-black text-[#111] tracking-tighter leading-none mb-12 uppercase not-italic">
        {t.pageTitle}
      </h1>
    </div>

    <div class="w-full h-[550px] overflow-hidden shadow-inner">
      <img 
        src="/images/regions/banner.png" 
        alt={t.pageTitle} 
        class="w-full h-full object-cover block" 
        onerror="this.src='https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?q=80&w=2070'"
      />
    </div>
  </section>

  <ServiceGrid 
    title={t.mainServices.title}
    description={t.mainServices.desc}
    items={t.mainServices.items}
  />

  <section class="py-20 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="lg:w-1/2 w-full">
          <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
            <img src="/images/regions/consulting.jpg" alt="Consulting" class="w-full h-full object-cover" onerror="this.src='/images/regions/consulting.jpg'"/>
          </div>
        </div>
        
        <div class="lg:w-1/2 w-full text-left">
          <h2 class="text-3xl font-black text-gray-900 mb-6 leading-tight not-italic uppercase tracking-tight">{t.consulting.title}</h2>
          <p class="text-gray-600 mb-8 italic border-l-4 border-[#ee5931] pl-4 bg-orange-50 py-3">
            {t.consulting.desc}
          </p>
          
          <ul class="space-y-4 mb-10">
            {t.consulting.list.map((li) => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-[#ee5931] mr-3 mt-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700 font-medium">{li}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-4">
            <button id="btn-open-modal" class="px-8 py-3.5 bg-[#ee5931] text-white font-bold rounded-md hover:bg-[#d44d28] transition-all shadow-md">
              {t.consulting.btnDetail}
            </button>
            <a href="#" class="px-8 py-3.5 border border-gray-300 text-gray-700 font-bold rounded-md hover:bg-gray-50 transition-all">
              {t.consulting.btnPdf}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-gray-50 border-t border-gray-100">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      <h2 class="text-4xl font-black text-gray-900 mb-12 text-center not-italic uppercase tracking-tight">{t.faq.title}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {t.faq.items.map((item) => (
          <a href="#" class="bg-white p-8 rounded-xl shadow-sm border border-gray-200 hover:border-orange-400 hover:shadow-lg transition-all group">
            <span class="text-xs font-black text-[#ee5931] uppercase tracking-widest mb-3 block">{item.cat}</span>
            <h3 class="text-xl font-bold text-gray-800 group-hover:text-[#ee5931] transition-colors leading-snug not-italic">
              {item.q}
            </h3>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-12">
        <a href="#" class="inline-block px-10 py-3 bg-white border border-gray-300 rounded-full font-bold text-[#ee5931] hover:border-[#ee5931] hover:bg-orange-50 transition-all">
          {t.faq.moreBtn}
        </a>
      </div>
    </div>
  </section>

  <OfficeFinder
    title={t.offices.title}
    description={t.offices.desc}
    labels={{
      selectCountry: t.offices.selectCountry,
      selectRegion: t.offices.selectRegion,
      btnGo: t.offices.btnGo
    }}
  />  

  <AskBanner 
    title={t.ask.title}
    btnText={t.ask.btn}
    link="/contact" 
  />

  <div id="consulting-modal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="fixed inset-0 z-10 overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
          <div class="bg-white px-6 pb-6 pt-6">
            <h3 class="text-2xl font-black leading-6 text-gray-900 mb-6 not-italic uppercase" id="modal-title">{t.consulting.popup.title}</h3>
            <div class="mt-2">
              <ul class="space-y-4">
                {t.consulting.popup.info.map((item) => (
                  <li class="border-b border-gray-100 pb-3">
                    <strong class="block text-sm font-bold text-gray-400 uppercase tracking-widest mb-1">{item.label}</strong>
                    <span class="text-gray-800 font-medium text-lg">{item.value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="bg-gray-50 px-6 py-4 sm:flex sm:flex-row-reverse">
            <button type="button" id="btn-close-modal" class="inline-flex w-full justify-center rounded-md bg-white px-6 py-2 text-sm font-bold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:w-auto transition-all">
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  import { initOfficeFinder } from '../../scripts/offices';

  document.addEventListener('astro:page-load', () => {
    initOfficeFinder();

    const modal = document.getElementById('consulting-modal');
    const btnOpen = document.getElementById('btn-open-modal');
    const btnClose = document.getElementById('btn-close-modal');
    const backdrop = document.getElementById('modal-backdrop');

    if(modal && btnOpen && btnClose && backdrop) {
      const toggleModal = (show: boolean) => {
        if(show) modal.classList.remove('hidden');
        else modal.classList.add('hidden');
      }
      btnOpen.addEventListener('click', () => toggleModal(true));
      btnClose.addEventListener('click', () => toggleModal(false));
      backdrop.addEventListener('click', () => toggleModal(false));
    }
  });
</script>