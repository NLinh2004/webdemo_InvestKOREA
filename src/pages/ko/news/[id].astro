---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { id: 'f1' } },
    { params: { id: 'f2' } },
    { params: { id: 'f3' } },
    { params: { id: 'm-name' } },
    { params: { id: 'e-name' } },
  ];
}

const { id } = Astro.params;
const lang = 'ko'; 
const t = useTranslations(lang);

const getNewsData = (id: string) => {
  if (id === 'f1') return { title: t('home.feat_1'), content: t('home.feat_1') };
  if (id === 'f2') return { title: t('home.feat_2'), content: t('home.feat_2') };
  if (id === 'f3') return { title: t('home.feat_3'), content: t('home.feat_3') };
  if (id === 'm-name') return { title: t('home.success_m_name'), content: t('home.success_m_desc') };
  if (id === 'e-name') return { title: t('home.success_e_name'), content: t('home.success_e_desc') };
  return { title: 'Tin tức', content: '' };
};

const post = getNewsData(id);
---

<Layout title={`${post.title} | Invest KOREA`} lang={lang}>
  <main class="bg-white antialiased">
    <article class="pt-28 pb-12 px-6 max-w-4xl mx-auto text-left">
      
      <nav class="mb-4 text-[10px] font-bold uppercase tracking-widest text-gray-400">
        <button onclick="history.back()" class="hover:text-[#ee5931] cursor-pointer uppercase">
          ← {t('nav.breadcrumb_home')}
        </button>
        <span class="mx-2">/</span>
        <span class="text-gray-300 uppercase">{t('home.feature_title')}</span>
      </nav>

      <h1 class="text-4xl md:text-5xl font-black text-[#111] leading-tight mb-8 tracking-tighter not-italic uppercase">
        {post.title}
      </h1>

      <div class="w-full aspect-video bg-gray-100 rounded-2xl mb-10 overflow-hidden shadow-sm">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab" class="w-full h-full object-cover shadow-inner" alt="Banner" />
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed font-medium not-italic mb-12 border-b border-gray-100 pb-12">
        <p>{post.content}</p>
      </div>

      <div class="text-center">
        <button 
          onclick="history.back()" 
          class="inline-block px-12 py-3 border-2 border-[#111] text-[#111] font-black uppercase text-[11px] tracking-widest hover:bg-[#111] hover:text-white transition-all cursor-pointer"
        >
          이전 페이지로 돌아가기
        </button>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Fix phông chữ và khoảng cách khít */
  main * { 
    font-style: normal !important; 
    letter-spacing: -0.015em; 
  }
</style>