---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ko'; 
const t = useTranslations(lang);

// 1. Dữ liệu Industries
const industriesList = [
  { key: 'machinery', icon: '⚙️' }, { key: 'energy', icon: '⚡' },
  { key: 'semiconductor', icon: '🔳' }, { key: 'tourism', icon: '🏖️' },
  { key: 'bio', icon: '🧪' }, { key: 'robot', icon: '🤖' },
  { key: 'shipbuilding', icon: '🚢' }, { key: 'ict', icon: '📡' },
  { key: 'aerospace', icon: '✈️' }, { key: 'battery', icon: '🔋' },
  { key: 'creative', icon: '🎬' }, { key: 'finance', icon: '📈' }
];

// 2. Dữ liệu Success Stories
const successStories = [
  { 
    nameKey: 'home.success_m_name', 
    descKey: 'home.success_m_desc', 
    img: 'https://images.unsplash.com/photo-1556761175-b413da4baf72' 
  },
  { 
    nameKey: 'home.success_e_name', 
    descKey: 'home.success_e_desc', 
    img: 'https://images.unsplash.com/photo-1560179707-f14e90ef3623' 
  }
];

// 3. Dữ liệu Features
const features = [
  { date: '2025.12.04', key: 'home.feat_1' },
  { date: '2025.11.07', key: 'home.feat_2' },
  { date: '2025.10.01', key: 'home.feat_3' }
];
---

<Layout title={t('home.title')} lang={lang}>
  <main class="bg-white">
    
    <section class="py-24 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-5xl font-black text-[#111] uppercase italic tracking-tighter mb-8">
          <span class="text-[#ee5931]">Korea</span>'s Solid <br/> {t('home.eco_title')}
        </h2>
        <div class="flex justify-center md:justify-end mb-20 text-right">
          <p class="max-w-xl text-gray-500 text-sm leading-relaxed italic">{t('home.eco_desc')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-16 items-center text-center md:text-left">
          <div class="flex items-center gap-6 justify-center md:justify-start">
            <span class="text-[11px] font-black text-[#ee5931] uppercase leading-tight w-20">{t('home.eco_rating_label')}</span>
            <span class="text-7xl font-black tracking-tighter text-[#111]">Aa2</span>
          </div>
          <div class="flex items-center gap-6 justify-center md:justify-start">
            <span class="text-[11px] font-black text-[#ee5931] uppercase leading-tight">GDP</span>
            <span class="text-7xl font-black tracking-tighter text-[#111]">12th</span>
          </div>
          <div class="flex items-center gap-6 justify-center md:justify-start">
            <span class="text-[11px] font-black text-[#ee5931] uppercase leading-tight">{t('home.eco_trade_label')}</span>
            <span class="text-7xl font-black tracking-tighter text-[#111]">9th</span>
          </div>
        </div>
      </div>
    </section>

    <section class="py-24 bg-[#f8f9fa]">
      <div class="container mx-auto px-6 text-center">
        <h2 class="text-4xl font-black text-[#111] uppercase italic tracking-tighter mb-12 italic">{t('home.complex_title')}</h2>
        <div class="rounded-2xl overflow-hidden shadow-2xl max-w-5xl mx-auto">
          <img src="https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=2000" class="w-full h-auto object-cover" />
        </div>
      </div>
    </section>

    <section class="bg-white py-24">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl font-black text-[#003366] uppercase tracking-tighter italic mb-16">{t('home.other_ind')}</h2>
        <div id="ind-slider" class="flex flex-nowrap overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide">
          <div class="min-w-full flex-shrink-0 snap-start grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
            {industriesList.slice(0, 8).map(item => (
              <a href="#" class="bg-white p-10 flex flex-col justify-between h-52 hover:bg-[#003366] transition-all group">
                <span class="text-4xl grayscale group-hover:grayscale-0 transition-all">{item.icon}</span>
                <div class="flex justify-between items-end">
                  <span class="text-sm font-black text-gray-700 group-hover:text-white uppercase tracking-tight leading-tight w-2/3 italic">
                    {t(`ind.${item.key}`)}
                  </span>
                  <span class="text-gray-300 group-hover:text-white transition-all">→</span>
                </div>
              </a>
            ))}
          </div>
          <div class="min-w-full flex-shrink-0 snap-start grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
            {industriesList.slice(4, 12).map(item => (
              <a href="#" class="bg-white p-10 flex flex-col justify-between h-52 hover:bg-[#003366] transition-all group">
                <span class="text-4xl grayscale group-hover:grayscale-0 transition-all">{item.icon}</span>
                <div class="flex justify-between items-end">
                  <span class="text-sm font-black text-gray-700 group-hover:text-white uppercase tracking-tight leading-tight w-2/3 italic">
                    {t(`ind.${item.key}`)}
                  </span>
                  <span class="text-gray-300 group-hover:text-white transition-all">→</span>
                </div>
              </a>
            ))}
          </div>
        </div>
        <div class="flex justify-center gap-4 mt-12">
          <button id="ind-prev" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">←</button>
          <button id="ind-next" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">→</button>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white border-t border-gray-100">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl font-black text-[#003366] uppercase italic tracking-tighter mb-16">{t('home.success_title')}</h2>
        <div id="success-slider" class="flex gap-12 overflow-x-auto scroll-smooth scrollbar-hide snap-x">
          {successStories.map(story => (
            <div class="min-w-full md:min-w-[calc(50%-24px)] group cursor-pointer snap-start">
              <div class="aspect-[16/10] bg-gray-100 rounded-2xl overflow-hidden mb-8">
                <img src={story.img} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" alt={t(story.nameKey)} />
              </div>
              <h3 class="text-2xl font-black mb-2 tracking-tighter">{t(story.nameKey)}</h3>
              <p class="text-gray-400 text-sm italic line-clamp-2">{t(story.descKey)}</p>
            </div>
          ))}
          <div class="min-w-full md:min-w-[calc(50%-24px)] snap-start hidden md:block"></div>
        </div>
        <div class="flex justify-center gap-4 mt-12">
          <button id="success-prev" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">←</button>
          <button id="success-next" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">→</button>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white border-t border-gray-50">
      <div class="container mx-auto px-6">
        <div class="flex flex-col lg:flex-row gap-16 mb-12">
          <div class="lg:w-1/4">
            <h2 class="text-5xl font-black text-[#003366] uppercase italic tracking-tighter mb-6">{t('regions.title')}</h2>
            <p class="text-gray-500 mb-10 leading-relaxed italic">{t('regions.description')}</p>
            <a href={`/${lang}/regions/`} class="inline-flex items-center justify-between bg-[#ee5931] text-white px-6 py-4 rounded-md font-bold uppercase italic hover:bg-[#d44d28] transition-all w-48">
              <span>{t('regions.btn_text')}</span> <span class="text-xl">→</span>
            </a>
          </div>
          <div id="reg-slider" class="lg:w-3/4 flex gap-4 overflow-x-auto scroll-smooth scrollbar-hide snap-x relative">
            {['Seoul', 'Incheon', 'Gyeonggi', 'Gangwon', 'Busan', 'Jeju'].map(city => (
              <div class="min-w-[320px] h-[450px] rounded-2xl relative overflow-hidden group cursor-pointer snap-start">
                <img src="https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=800" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt={city} />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
                <span class="absolute bottom-10 left-10 text-white text-3xl font-black uppercase italic tracking-tighter">{city}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="flex justify-center gap-4">
          <button id="reg-prev" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">←</button>
          <button id="reg-next" class="w-12 h-12 rounded-full border border-gray-200 flex items-center justify-center hover:bg-gray-50 active:scale-90 transition-all">→</button>
        </div>
      </div>
    </section>

    <section class="py-20 bg-gray-50 border-y border-gray-100">
      <div class="container mx-auto px-6">
        <h3 class="text-center text-3xl font-black text-[#003366] uppercase italic tracking-tighter mb-12">{t('footer.family')}</h3>
        <div class="flex flex-wrap justify-center items-center gap-x-16 gap-y-10 opacity-40 grayscale hover:grayscale-0 transition-all duration-700">
          <span class="text-2xl font-black italic text-[#111]">kotra</span>
          <span class="text-xl font-bold uppercase tracking-widest text-[#111]">Ombudsman</span>
          <span class="text-xl font-black italic text-[#111]">Invest KOREA</span>
          <span class="text-2xl font-bold text-[#111]">GEP</span>
        </div>
      </div>
    </section>

    <section class="py-24 bg-white">
      <div class="container mx-auto px-6">
        <h2 class="text-4xl font-black text-[#003366] mb-16 uppercase italic tracking-tighter">{t('home.feature_title')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16 text-left">
          {features.map(f => (
            <div class="group cursor-pointer">
              <div class="aspect-video rounded-xl overflow-hidden mb-6 bg-gray-200">
                <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
              </div>
              <p class="text-[16px] font-bold text-gray-800 leading-snug mb-3 group-hover:text-[#ee5931] transition-colors line-clamp-2">{t(f.key)}</p>
              <span class="text-xs text-gray-400 font-bold uppercase tracking-widest">{f.date}</span>
            </div>
          ))}
        </div>
        <div class="flex justify-center">
          <button class="px-12 py-3 border border-gray-200 text-gray-400 font-bold uppercase text-[11px] tracking-[0.2em] hover:bg-gray-50">{t('home.btn_more')}</button>
        </div>
      </div>
    </section>

    </main>
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  #ind-slider, #success-slider, #reg-slider { cursor: grab; }
</style>

<script>
  function initSlider(sliderId, prevId, nextId, scrollOffset = 0) {
    const slider = document.getElementById(sliderId);
    const prev = document.getElementById(prevId);
    const next = document.getElementById(nextId);

    if (slider && prev && next) {
      next.addEventListener('click', () => {
        const step = scrollOffset || slider.offsetWidth;
        slider.scrollLeft += step;
      });
      prev.addEventListener('click', () => {
        const step = scrollOffset || slider.offsetWidth;
        slider.scrollLeft -= step;
      });
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initSlider('ind-slider', 'ind-prev', 'ind-next');
    initSlider('success-slider', 'success-prev', 'success-next');
    initSlider('reg-slider', 'reg-prev', 'reg-next', 336);
  });
</script>