---
import Layout from '../../../layouts/Layout.astro'; // Chỉnh lại đường dẫn layout do nằm trong thư mục con
import { useTranslations } from '../../../i18n/utils';

const lang = 'ko'; 
const t = useTranslations(lang);

// Dữ liệu 17 ngành công nghiệp
const fullIndustries = [
  { key: 'aerospace', icon: '🚀' }, 
  { key: 'automobile', icon: '🚗' }, // Khớp với key 'ind.automobile' trong i18n
  { key: 'battery', icon: '🔋' }, 
  { key: 'consumer', icon: '🎁' },
  { key: 'cultural', icon: '🎬' }, 
  { key: 'display', icon: '🖥️' },
  { key: 'finance', icon: '📈' }, 
  { key: 'chemical', icon: '🧪' },
  { key: 'ict', icon: '📡' }, 
  { key: 'logistics', icon: '📦' },
  { key: 'machinery', icon: '⚙️' }, 
  { key: 'bio', icon: '🧬' },
  { key: 'energy', icon: '⚡' }, 
  { key: 'robot', icon: '🤖' },
  { key: 'semiconductor', icon: '🔳' }, 
  { key: 'shipbuilding', icon: '🚢' },
  { key: 'tourism', icon: '🗺️' }
];

const industryNews = [
  { title: t('ind.news_item_1'), date: "2025.12.05" },
  { title: t('ind.news_item_2'), date: "2025.11.11" }
];
---

<Layout title={t('ind.title')} lang={lang}>
  <main class="bg-white overflow-hidden">
    
    <section class="pt-24 pb-0">
      <div class="max-w-6xl mx-auto px-6">
        <nav class="text-[13px] text-gray-400 mb-6 font-bold italic uppercase tracking-wider">
          홈 · <span class="text-gray-900">{t('ind.title')}</span>
        </nav>
        <h1 class="text-[56px] font-black text-[#111] tracking-tighter leading-none mb-10 uppercase italic">
          {t('ind.title')}
        </h1>
      </div>
      <div class="w-full h-[350px] overflow-hidden">
        <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158" class="w-full h-full object-cover" alt="Industries Banner" />
      </div>
    </section>

    <section class="py-20">
      <div class="max-w-6xl mx-auto px-6 text-left">
        <h2 class="text-[36px] font-black text-[#003366] uppercase tracking-tighter italic mb-4">
          {t('ind.priority_title')}
        </h2>
        <p class="text-gray-500 font-bold italic mb-12 max-w-3xl text-[15px] leading-relaxed">
          {t('ind.priority_desc')}
        </p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200 shadow-sm">
          {fullIndustries.map(item => (
            <a href={`/ko/industries/${item.key}`} class="bg-white p-10 flex flex-col justify-between h-48 hover:bg-[#003366] transition-all group">
              <span class="text-3xl grayscale group-hover:grayscale-0 transition-all">{item.icon}</span>
              <div class="flex justify-between items-end">
                <span class="text-[14px] font-black text-gray-700 group-hover:text-white uppercase italic tracking-tight leading-tight w-2/3">
                  {t(`ind.${item.key}`)}
                </span>
                <span class="text-gray-300 group-hover:text-white text-lg group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-24 bg-gray-50/50 border-y border-gray-100">
      <div class="max-w-6xl mx-auto px-6 space-y-28">
        
        <div class="flex flex-col md:flex-row gap-12 items-center">
          <div class="flex-1 rounded-2xl overflow-hidden shadow-xl border border-gray-100 group">
            <img src="https://images.unsplash.com/photo-1526772662000-3f88f10405ff" class="w-full h-[320px] object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="flex-1 space-y-5 text-left">
            <h3 class="text-[30px] font-black text-[#111] leading-tight uppercase italic tracking-tighter">{t('ind.cluster_1_title')}</h3>
            <p class="text-[#ee5931] font-black italic uppercase text-[12px] tracking-widest">{t('ind.cluster_1_sub')}</p>
            <p class="text-gray-500 font-bold italic leading-relaxed text-[15px]">{t('ind.priority_desc')}</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row-reverse gap-12 items-center">
          <div class="flex-1 rounded-2xl overflow-hidden shadow-xl border border-gray-100 group">
            <img src="https://images.unsplash.com/photo-1518770660439-4636190af475" class="w-full h-[320px] object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="flex-1 space-y-5 text-left">
            <h3 class="text-[30px] font-black text-[#111] leading-tight uppercase italic tracking-tighter">{t('ind.cluster_2_title')}</h3>
            <p class="text-[#ee5931] font-black italic uppercase text-[12px] tracking-widest">{t('ind.cluster_2_sub')}</p>
            <p class="text-gray-500 font-bold italic leading-relaxed text-[15px]">{t('ind.priority_desc')}</p>
          </div>
        </div>

        <div class="flex flex-col md:flex-row gap-12 items-center">
          <div class="flex-1 rounded-2xl overflow-hidden shadow-xl border border-gray-100 group">
            <img src="https://images.unsplash.com/photo-1556761175-b413da4baf72" class="w-full h-[320px] object-cover group-hover:scale-105 transition-transform duration-700" />
          </div>
          <div class="flex-1 space-y-5 text-left">
            <h3 class="text-[30px] font-black text-[#111] leading-tight uppercase italic tracking-tighter">{t('ind.startup_title')}</h3>
            <p class="text-[#ee5931] font-black italic uppercase text-[12px] tracking-widest">{t('ind.startup_sub')}</p>
            <p class="text-gray-500 font-bold italic leading-relaxed text-[15px]">{t('ind.startup_desc')}</p>
            <button class="bg-[#ee5931] text-white px-8 py-3 rounded-lg font-black uppercase italic tracking-widest text-[11px] hover:bg-[#d44d28] transition-all shadow-lg active:scale-95">
              {t('ind.startup_btn')} →
            </button>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 bg-white">
      <div class="max-w-6xl mx-auto px-6 text-left">
        <h2 class="text-[36px] font-black text-[#003366] uppercase tracking-tighter italic mb-12">{t('ind.news')}</h2>
        <div class="border-t border-gray-100">
          {industryNews.map(news => (
            <div class="py-10 border-b border-gray-100 hover:bg-gray-50 transition-all px-4 group flex flex-col md:flex-row md:justify-between md:items-center gap-4">
              <h3 class="text-[18px] font-bold text-gray-800 group-hover:text-[#ee5931] transition-colors italic leading-snug md:w-4/5">
                {news.title}
              </h3>
              <p class="text-[12px] text-gray-400 font-bold uppercase">{news.date}</p>
            </div>
          ))}
        </div>
        <div class="flex justify-center mt-12">
          <button class="px-14 py-3.5 border border-gray-200 text-gray-400 font-black uppercase text-[11px] tracking-[0.3em] hover:bg-gray-50 transition-all active:scale-95">
            {t('ind.more_btn')}
          </button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main {
    word-break: keep-all;
    -webkit-font-smoothing: antialiased;
  }
</style>