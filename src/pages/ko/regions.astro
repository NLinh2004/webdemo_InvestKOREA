---
import Layout from '../../layouts/Layout.astro';
import { regions, regionData, locationReportsData, kfezData } from '../../i18n/_regions';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

// Lấy danh sách Map
const allRegions = regionData.categories.flatMap(cat => cat.items);

// Lấy ngôn ngữ hiện tại
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const translate = useTranslations(lang);

// Lấy dữ liệu Báo cáo theo ngôn ngữ
const currentReports = locationReportsData[lang as keyof typeof locationReportsData] || locationReportsData.ko;

// Lấy dữ liệu KFEZ theo ngôn ngữ
const currentKfez = kfezData[lang as keyof typeof kfezData] || kfezData.vi;
const t = regions[lang as keyof typeof regions] || regions.vi;
---

<Layout title={`${t["reg.title"]} - Invest KOREA`} lang={lang}>
  
  <section class="w-full">
    <div class="pt-12 pb-12 px-6 max-w-7xl mx-auto">
      <nav class="text-sm text-gray-400 mb-8 font-bold not-italic uppercase tracking-widest">
        <a href={`/${lang}`} class="hover:text-gray-600">홈</a> · <span class="text-gray-900">{t["reg.title"]}</span>
      </nav>
      
      <h1 class="text-[80px] font-black text-[#111] tracking-tighter leading-none mb-12 uppercase not-italic">
        {t["reg.title"]}
      </h1>
    </div>

    <div class="w-full h-[550px] overflow-hidden shadow-inner">
      <img 
        src="/images/regions/banner.png" 
        alt={t["reg.title"]} 
        class="w-full h-full object-cover block" 
      />
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex flex-col lg:flex-row gap-16"> 
        <div class="lg:w-1/3">
          <h2 class="text-3xl font-bold mb-6 text-gray-800 leading-tight not-italic">
            Seoul, Vươn mình trở thành Trung tâm Kinh doanh Đông Bắc Á
          </h2>
          <div class="bg-gray-50 p-6 rounded-xl mb-10 text-sm text-gray-600 border border-gray-100">
            <strong class="block mb-2 text-gray-900 text-base font-bold">17 tỉnh thành của Hàn Quốc cung cấp môi trường và dịch vụ đầu tư chuyên biệt.</strong>
            <p class="text-blue-600 italic">* Nhấp vào tên khu vực để xem vị trí trên bản đồ.</p>
          </div>

          <div class="space-y-8">
            {regionData.categories.map((category) => (
              <div>
                <h3 class="text-lg font-bold border-b-2 border-gray-800 pb-3 mb-4 uppercase tracking-wider">{category.name}</h3>
                <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
                  {category.items.map((item) => (
                    <li>
                      <a 
                        href={`/${lang}/regions/${item.slug}`} 
                        class="region-link block px-3 py-2 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors text-[15px] font-medium"
                        data-id={item.id}
                      >
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:w-2/3 flex justify-center items-start pt-10">
          <div class="relative w-full max-w-[800px]">
            <img 
              id="korea-map-img" 
              src="/images/regions/map_00.png" 
              alt="Korea Map" 
              usemap="#KoreaMap"
              class="w-full h-auto drop-shadow-xl"
            />
            <map name="KoreaMap" id="KoreaMap">
              {allRegions.map((item) => (
                <area 
                  shape={item.shape} 
                  coords={item.coords} 
                  href={`/${lang}/regions/${item.slug}`} 
                  alt={item.name}
                  data-id={item.id}
                  class="cursor-pointer"
                />
              ))}
            </map>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 py-24">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-16 max-w-4xl mx-auto">
        <h2 class="text-4xl font-black mb-6 text-gray-900 leading-tight uppercase not-italic tracking-tight">
          {currentKfez.title}
        </h2>
        <p class="text-gray-600 text-lg leading-relaxed">
          {currentKfez.description}
        </p>
      </div>

      <div class="hidden md:flex flex-row bg-white rounded-xl shadow-xl overflow-hidden border border-gray-100">
        <div class="w-[280px] flex-shrink-0 bg-white border-r border-gray-200 flex flex-col py-6">
          {currentKfez.items.map((item, index) => (
            <button 
              class={`kfez-tab-btn w-full text-left px-8 py-4 text-[15px] font-bold transition-all duration-200 flex justify-between items-center group
                ${index === 0 ? 'bg-[#ee5931] text-white shadow-md' : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900 border-l-4 border-transparent'}`}
              data-index={index}
            >
              <span>{item.name}</span>
            </button>
          ))}
        </div>
        <div class="flex-1 p-14 relative bg-white min-h-[450px]">
          {currentKfez.items.map((item, index) => (
            <div 
              class={`kfez-content absolute inset-0 p-14 transition-all duration-500 ease-out
                ${index === 0 ? 'opacity-100 translate-y-0 z-10' : 'opacity-0 translate-y-4 -z-10 pointer-events-none'}`}
              data-index={index}
            >
              <h3 class="text-3xl font-black text-gray-900 mb-6 pb-6 border-b border-gray-100 not-italic">
                {item.fullName}
              </h3>
              <p class="text-gray-600 mb-10 leading-loose text-lg font-medium">
                {item.desc}
              </p>
              <a href={item.link} target="_blank" class="inline-flex items-center gap-3 px-8 py-3.5 bg-[#ee5931] text-white font-bold rounded hover:bg-[#d44d28] transition-all group">
                TRUY CẬP WEBSITE
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-24 border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-6">
      <div class="flex justify-between items-end mb-12 border-b border-gray-200 pb-6">
        <h2 class="text-3xl font-black text-gray-900 not-italic uppercase tracking-tight">
          {currentReports.title}
        </h2>
        <a href={currentReports.moreLink} class="text-[#ee5931] hover:underline font-bold flex items-center gap-2 transition-colors text-lg group">
          {currentReports.moreText}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {currentReports.items.map((report) => (
          <a href={report.link} class="group block h-full flex flex-col">
            <div class="relative overflow-hidden rounded-lg mb-5 aspect-[4/3] shadow-sm">
              <img src={report.image} alt={report.title} class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700" />
            </div>
            <div class="flex-1">
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-[#ee5931] transition-colors mb-4 line-clamp-2 leading-snug not-italic">
                {report.title}
              </h3>
              <div class="mt-auto pt-4 border-t border-gray-100 text-sm text-gray-500">
                {report.date}
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  import { initRegionsPage } from '../../scripts/regions';
  document.addEventListener('DOMContentLoaded', initRegionsPage);
  document.addEventListener('astro:page-load', initRegionsPage);
</script>

<style>
  .region-link.active {
    color: #ee5931; 
    font-weight: 900;
  }
</style>