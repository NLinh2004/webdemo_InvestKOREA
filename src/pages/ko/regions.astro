---
import Layout from '../../layouts/Layout.astro';
import { regions,regionData, locationReportsData, kfezData } from '../../i18n/_regions';
import { getLangFromUrl } from '../../i18n/utils';

// Lấy danh sách Map
const allRegions = regionData.categories.flatMap(cat => cat.items);

// Lấy ngôn ngữ hiện tại
const lang = Astro.props.lang || getLangFromUrl(Astro.url);

// Lấy dữ liệu Báo cáo theo ngôn ngữ
const currentReports = locationReportsData[lang as keyof typeof locationReportsData] || locationReportsData.vi;

// Lấy dữ liệu KFEZ theo ngôn ngữ (MỚI)
const currentKfez = kfezData[lang as keyof typeof kfezData] || kfezData.vi;

---

<Layout title="Regions - Invest KOREA">
  
  <div class="w-full relative h-[300px] overflow-hidden">
    <img src="/images/regions/banner.jpg" alt="Regions Banner" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/30 flex items-center">
      <div class="max-w-[1400px] w-full mx-auto px-6 md:px-12 lg:px-20">
        <h1 class="text-4xl text-white font-bold">Regions</h1>
      </div>
    </div>
  </div>

  <section class="py-16 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      
      <div class="flex flex-col lg:flex-row gap-16"> <div class="lg:w-1/3">
          <h2 class="text-3xl font-bold mb-6 text-gray-800 leading-tight">
            동북아 비즈니스 허브로 도약하는 서울
          </h2>
          <div class="bg-gray-50 p-6 rounded-xl mb-10 text-sm text-gray-600 border border-gray-100">
            <strong class="block mb-2 text-gray-900 text-base">대한민국의 17개 시도는 특화된 투자 환경과 서비스를 제공합니다.</strong>
            <p class="text-blue-600 italic">* 지역명을 클릭하시면 해당 위치가 지도에 표시됩니다.</p>
          </div>

          <div class="space-y-8">
            {regionData.categories.map((category) => (
              <div>
                <h3 class="text-lg font-bold border-b-2 border-gray-800 pb-3 mb-4">{category.name}</h3>
                <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
                  {category.items.map((item) => (
                    <li>
                      <a 
                        href={`/vi/regions/${item.slug}`} 
                        class="region-link block px-3 py-2 text-gray-600 hover:text-blue-600 hover:bg-blue-50 rounded transition-colors text-[15px]"
                        data-id={item.id}
                      >
                        {item.name}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:w-2/3 flex justify-center items-start pt-10">
          <div class="relative w-full max-w-[800px]">
            <img 
              id="korea-map-img" 
              src="/images/regions/map_00.png" 
              alt="Korea Map" 
              usemap="#KoreaMap"
              class="w-full h-auto drop-shadow-xl"
            />
            
            <map name="KoreaMap" id="KoreaMap">
              {allRegions.map((item) => (
                <area 
                  shape={item.shape} 
                  coords={item.coords} 
                  href={`/vi/regions/${item.slug}`} 
                  alt={item.name}
                  data-id={item.id}
                  class="cursor-pointer"
                />
              ))}
            </map>
          </div>
        </div>
      </div>

    </div>
  </section>

  
  <section class="bg-gray-50 pb-24">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      
      <div class="text-center mb-16 max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-gray-900 leading-tight">
          {currentKfez.title}
        </h2>
        <p class="text-gray-600 text-lg leading-relaxed">
          {currentKfez.description}
        </p>
      </div>

      <div class="md:hidden mb-8">
        <label for="kfez-select" class="sr-only">Select Region</label>
        <div class="relative">
          <select id="kfez-select" class="block w-full px-4 py-3 text-base text-gray-900 border border-gray-300 rounded-lg bg-white focus:ring-orange-500 focus:border-orange-500 appearance-none shadow-sm">
            {currentKfez.items.map((item, index) => (
              <option value={index}>{item.name}</option>
            ))}
          </select>
          <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-gray-700">
            <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
          </div>
        </div>
      </div>

      <div class="hidden md:flex flex-row bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
  
  <div class="w-[280px] flex-shrink-0 bg-white border-r border-gray-200 flex flex-col py-6">
    {currentKfez.items.map((item, index) => (
      <button 
        class={`kfez-tab-btn w-full text-left px-8 py-4 text-[15px] font-medium transition-all duration-200 flex justify-between items-center group
          ${index === 0 
            ? 'bg-orange-600 text-white shadow-md'  /* ACTIVE: NỀN CAM, CHỮ TRẮNG */
            : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900 border-l-4 border-transparent hover:border-orange-200' /* INACTIVE */
          }`}
        data-index={index}
      >
        <span>{item.name}</span>
        <svg 
          class={`w-4 h-4 transition-transform duration-200 
            ${index === 0 
              ? 'text-white opacity-100 translate-x-0' /* <-- ICON TRẮNG KHI ACTIVE */
              : 'text-gray-400 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0'
            }`} 
          fill="none" viewBox="0 0 24 24" stroke="currentColor"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    ))}
  </div>

        <div class="flex-1 p-10 lg:p-14 relative bg-white min-h-[400px]">
          {currentKfez.items.map((item, index) => (
            <div 
              class={`kfez-content absolute inset-0 p-10 lg:p-14 transition-all duration-500 ease-out
                ${index === 0 ? 'opacity-100 translate-y-0 z-10' : 'opacity-0 translate-y-4 -z-10 pointer-events-none'}`}
              data-index={index}
            >
              <h3 class="text-3xl font-bold text-gray-900 mb-6 pb-6 border-b border-gray-100">
                {item.fullName}
              </h3>
              <p class="text-gray-600 mb-10 leading-loose text-lg">
                {item.desc}
              </p>
              
              <a 
                href={item.link} 
                target="_top" 
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 px-8 py-3.5 border border-orange-500 text-orange-600 font-semibold rounded hover:bg-orange-50 transition-all duration-300 group"
              >
                웹사이트 접속하기
                <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          ))}
        </div>

      </div>

    </div>
  </section>


<section class="bg-white py-24 border-t border-gray-100">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      
      <div class="flex justify-between items-end mb-12 border-b border-gray-200 pb-6">
        <h2 class="text-3xl font-bold text-gray-900">
          {currentReports.title}
        </h2>
        <a 
          href={currentReports.moreLink} 
          class="text-gray-500 hover:text-orange-600 font-medium flex items-center gap-2 transition-colors text-lg group"
        >
          {currentReports.moreText}
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {currentReports.items.map((report) => (
          <a href={report.link} class="group block h-full flex flex-col">
            
            <div class="relative overflow-hidden rounded-xl mb-5 aspect-[4/3] shadow-sm group-hover:shadow-lg transition-all duration-300">
              <img 
                src={report.image} 
                alt={report.title} 
                class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700"
                onerror="this.src='/images/placeholder.jpg'" 
              />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors duration-300"></div>
            </div>

            <div class="flex-1 flex flex-col">
              {report.tags && report.tags.length > 0 && (
                <div class="flex gap-2 mb-3">
                  {report.tags.map(tag => (
                    <span class="text-xs font-bold text-orange-600 bg-orange-50 px-2.5 py-1 rounded border border-orange-100">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <h3 class="text-xl font-bold text-gray-900 group-hover:text-orange-600 transition-colors mb-4 line-clamp-2 leading-snug">
                {report.title}
              </h3>

              <div class="mt-auto pt-4 border-t border-gray-100 flex items-center text-sm text-gray-500">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {report.date}
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-12 text-center md:hidden">
        <a 
          href={currentReports.moreLink} 
          class="inline-block px-8 py-3 border border-gray-300 rounded-full text-gray-700 font-medium hover:border-orange-600 hover:text-orange-600 transition-colors"
        >
          {currentReports.moreText}
        </a>
      </div>

    </div>
  </section>

</Layout>

<script>
  import { initRegionsPage } from '../../scripts/regions';
  document.addEventListener('DOMContentLoaded', initRegionsPage);
  document.addEventListener('astro:page-load', initRegionsPage);
</script>

<style>
  .region-link.active {
    color: #2563EB; 
    font-weight: bold;
  }
</style>