---
import Layout from '../../layouts/Layout.astro';
import { servicesData } from '../../i18n/_services';
import { getLangFromUrl } from '../../i18n/utils';

// Lấy ngôn ngữ hiện tại
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = servicesData[lang as keyof typeof servicesData] || servicesData.vi;
---

<Layout title={`${t.pageTitle} - Invest KOREA`}>
  
  <div class="w-full relative h-[300px] overflow-hidden">
    <img src="/public/images/regions/banner.png" alt="Regions Banner" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/30 flex items-center">
      <div class="max-w-[1400px] w-full mx-auto px-6 md:px-12 lg:px-20">
        <h1 class="text-4xl text-white font-bold">{t.pageTitle}</h1>
      </div>
    </div>
  </div>

  <section class="py-20 bg-gray-50">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">{t.mainServices.title}</h2>
      <p class="text-gray-600 mb-12 max-w-3xl mx-auto text-lg">{t.mainServices.desc}</p>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {t.mainServices.items.map((item) => (
          <a href={item.link} class="bg-white p-8 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 flex flex-col items-center group border border-gray-100 hover:border-orange-200">
            <div class="text-4xl mb-4 group-hover:scale-110 transition-transform">{item.icon}</div>
            <h3 class="text-xl font-bold text-gray-800 group-hover:text-orange-600 transition-colors">{item.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex flex-col lg:flex-row gap-12 items-center">
        <div class="lg:w-1/2 w-full">
          <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
            <img src="/public/images/services/consulting.png" alt="Consulting" class="w-full h-full object-cover" onerror="this.src='/public/images/services/consuling.png'"/>
          </div>
        </div>
        
        <div class="lg:w-1/2 w-full">
          <h2 class="text-3xl font-bold text-gray-900 mb-6 leading-tight">{t.consulting.title}</h2>
          <p class="text-gray-600 mb-8 italic border-l-4 border-orange-500 pl-4 bg-orange-50 py-2">
            {t.consulting.desc}
          </p>
          
          <ul class="space-y-3 mb-10">
            {t.consulting.list.map((li) => (
              <li class="flex items-start">
                <svg class="w-5 h-5 text-green-500 mr-3 mt-1 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-gray-700">{li}</span>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap gap-4">
            <button id="btn-open-modal" class="px-6 py-3 bg-orange-600 text-white font-semibold rounded-lg hover:bg-orange-700 transition-colors shadow-md">
              {t.consulting.btnDetail}
            </button>
            <a href="#" class="px-6 py-3 border border-gray-300 text-gray-700 font-semibold rounded-lg hover:bg-gray-50 transition-colors">
              {t.consulting.btnPdf}
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50 border-t border-gray-100">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      <h2 class="text-3xl font-bold text-gray-900 mb-10 text-center">{t.faq.title}</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {t.faq.items.map((item) => (
          <a href="#" class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 hover:border-orange-400 hover:shadow-md transition-all group">
            <span class="text-xs font-bold text-orange-500 uppercase tracking-wide mb-2 block">{item.cat}</span>
            <h3 class="text-lg font-medium text-gray-800 group-hover:text-orange-600 transition-colors">
              {item.q}
            </h3>
          </a>
        ))}
      </div>
      
      <div class="text-center mt-10">
        <a href="#" class="inline-block px-8 py-3 bg-white border border-gray-300 rounded-full font-medium text-gray-600 hover:text-orange-600 hover:border-orange-600 transition-all">
          {t.faq.moreBtn}
        </a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 lg:px-20">
      <div class="flex flex-col md:flex-row bg-slate-900 rounded-2xl overflow-hidden shadow-2xl">
        <div class="md:w-1/2 relative h-64 md:h-auto">
          <img src="/public/images/services/office_map.png" alt="Office Map" class="w-full h-full object-cover opacity-80" onerror="this.src='/public/images/office_map.png'" />
          <div class="absolute inset-0 bg-gradient-to-r from-slate-900 to-transparent md:bg-gradient-to-r"></div>
        </div>
        
        <div class="md:w-1/2 p-10 md:p-16 flex flex-col justify-center text-white">
          <h2 class="text-3xl font-bold mb-4">{t.offices.title}</h2>
          <p class="text-slate-300 mb-8">{t.offices.desc}</p>
          
          <div class="space-y-4 max-w-sm">
            <select id="office-country" class="w-full px-4 py-3 rounded bg-slate-800 border border-slate-600 text-white focus:outline-none focus:border-orange-500">
              <option value="">{t.offices.selectCountry}</option>
              <option value="usa">United States</option>
              <option value="vietnam">Vietnam</option>
              <option value="korea">Korea</option>
            </select>
            
            <select id="office-region" class="w-full px-4 py-3 rounded bg-slate-800 border border-slate-600 text-white focus:outline-none focus:border-orange-500" disabled>
              <option value="">{t.offices.selectRegion}</option>
            </select>
            
            <button id="office-go-btn" class="w-full px-6 py-3 bg-orange-600 hover:bg-orange-500 text-white font-bold rounded transition-colors flex justify-center items-center gap-2">
              {t.offices.btnGo}
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-orange-50 border-t border-orange-100">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold text-gray-900 mb-6">{t.ask.title}</h2>
      <a href="#" class="inline-flex items-center px-8 py-4 bg-gray-900 text-white text-lg font-bold rounded-full hover:bg-gray-800 transition-transform hover:-translate-y-1 shadow-lg">
        {t.ask.btn}
        <svg class="w-5 h-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </a>
    </div>
  </section>

  <div id="consulting-modal" class="fixed inset-0 z-50 hidden" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="fixed inset-0 bg-black bg-opacity-50 transition-opacity backdrop-blur-sm" id="modal-backdrop"></div>

    <div class="fixed inset-0 z-10 overflow-y-auto">
      <div class="flex min-h-full items-end justify-center p-4 text-center sm:items-center sm:p-0">
        <div class="relative transform overflow-hidden rounded-lg bg-white text-left shadow-xl transition-all sm:my-8 sm:w-full sm:max-w-lg">
          <div class="bg-white px-4 pb-4 pt-5 sm:p-6 sm:pb-4">
            <h3 class="text-xl font-bold leading-6 text-gray-900 mb-4" id="modal-title">{t.consulting.popup.title}</h3>
            <div class="mt-2">
              <ul class="space-y-4">
                {t.consulting.popup.info.map((item) => (
                  <li class="border-b border-gray-100 pb-2">
                    <strong class="block text-sm font-semibold text-gray-700">{item.label}</strong>
                    <span class="text-gray-600">{item.value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class="bg-gray-50 px-4 py-3 sm:flex sm:flex-row-reverse sm:px-6">
            <button type="button" id="btn-close-modal" class="mt-3 inline-flex w-full justify-center rounded-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 hover:bg-gray-50 sm:mt-0 sm:w-auto">
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

</Layout>

<script>
  // Import Logic
  import { initOfficeFinder } from '../../scripts/offices';

  document.addEventListener('astro:page-load', () => {
    initOfficeFinder();

    // Logic Modal (Popup)
    const modal = document.getElementById('consulting-modal');
    const btnOpen = document.getElementById('btn-open-modal');
    const btnClose = document.getElementById('btn-close-modal');
    const backdrop = document.getElementById('modal-backdrop');

    if(modal && btnOpen && btnClose && backdrop) {
      const toggleModal = (show: boolean) => {
        if(show) modal.classList.remove('hidden');
        else modal.classList.add('hidden');
      }

      btnOpen.addEventListener('click', () => toggleModal(true));
      btnClose.addEventListener('click', () => toggleModal(false));
      backdrop.addEventListener('click', () => toggleModal(false));
    }
  });
</script>