---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  const ids = ['economy', 'fundamental', 'sustainable', 'stories'];
  return ids.map(id => ({ params: { id } }));
}

const { id } = Astro.params;
const lang = 'vi';
const t = useTranslations(lang);

// Helper lấy data
const getVal = (key: string, fallback: string = "") => {
  const value = t(key);
  return value.includes('why.') ? fallback : value;
};

const pageData = {
  title: getVal(`why.${id}_title`, "Đang cập nhật"),
  subtitle: getVal(`why.${id}_sub`, "Tổng quan"),
  description: getVal(`why.${id}_desc`, "Nội dung đang được cập nhật..."),
  image: getVal(`why.${id}_img`, 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab'),
  h1: getVal(`why.${id}_h1`),
  h2: getVal(`why.${id}_h2`)
};
---

<Layout title={`${pageData.title} | Invest KOREA`} lang={lang}>
  <main class="bg-white antialiased selection:bg-[#ee5931] selection:text-white">
    <header class="relative h-[60vh] min-h-[500px] w-full overflow-hidden">
      <img src={pageData.image} class="absolute inset-0 w-full h-full object-cover scale-105 animate-slow-zoom" alt="Hero" />
      <div class="absolute inset-0 bg-gradient-to-b from-black/10 via-black/40 to-[#111]"></div>
      <div class="absolute inset-0 flex flex-col justify-end pb-16">
        <div class="container mx-auto px-6 max-w-7xl">
          <nav class="mb-8 flex items-center gap-4 text-[10px] font-bold uppercase tracking-[0.3em] text-white/70">
            <button onclick="history.back()" class="hover:text-[#ee5931] transition-all cursor-pointer flex items-center gap-2">
              <span class="text-lg">←</span> {t('why.title')}
            </button>
            <span class="w-8 h-px bg-white/30"></span>
            <span class="text-white font-black italic">{id} overview</span>
          </nav>
          <h1 class="text-[clamp(2.5rem,7vw,4.5rem)] font-black text-white leading-[1.1] tracking-tight uppercase not-italic">
              {pageData.title}
          </h1>
        </div>
      </div>
    </header>

    <section class="py-24">
      <div class="container mx-auto px-6 max-w-7xl grid lg:grid-cols-12 gap-16 items-start">
        <div class="lg:col-span-4 sticky top-32">
          <p class="text-xs font-black uppercase tracking-[0.4em] text-[#ee5931] mb-6">CHIẾN LƯỢC</p>
          <h2 class="text-3xl font-black text-[#111] leading-[1.3] uppercase mb-10">{pageData.subtitle}</h2>
          {(pageData.h1 || pageData.h2) && (
            <div class="space-y-10 border-l-2 border-gray-100 pl-8">
              {pageData.h1 && <p class="text-4xl font-black text-[#111] hover:text-[#ee5931] transition-colors">{pageData.h1}</p>}
              {pageData.h2 && <p class="text-4xl font-black text-[#111] hover:text-[#ee5931] transition-colors">{pageData.h2}</p>}
            </div>
          )}
        </div>
        <div class="lg:col-span-8">
          <div class="prose prose-slate max-w-none">
            <div class="whitespace-pre-line text-lg md:text-xl text-gray-700 leading-relaxed font-medium">
              {pageData.description}
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="py-32 bg-gray-50/50 border-t border-gray-100 text-center">
      <button onclick="history.back()" class="group inline-flex flex-col items-center gap-6">
        <div class="w-20 h-20 rounded-full border border-gray-200 flex items-center justify-center bg-white group-hover:bg-[#ee5931] group-hover:text-white transition-all duration-500">
          <span class="text-3xl">←</span>
        </div>
        <p class="text-sm font-black uppercase tracking-widest text-[#111] group-hover:text-[#ee5931]">QUAY LẠI</p>
      </button>
    </footer>
  </main>
</Layout>

<style>
  @keyframes slow-zoom { from { transform: scale(1); } to { transform: scale(1.1); } }
  .animate-slow-zoom { animation: slow-zoom 25s infinite alternate ease-in-out; }
  main * { font-style: normal !important; letter-spacing: -0.01em; }
</style>