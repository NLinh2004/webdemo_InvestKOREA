---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';

// Thiết lập ngôn ngữ
const lang = 'vi'; 
const t = useTranslations(lang);

/**
 * Cấu hình đường dẫn thực tế
 * Lưu ý: Các trang này sẽ chạy thông qua file [id].astro trong thư mục why-korea
 */
const paths = {
  home: `/${lang}`,
  news: `/${lang}/news`,
  industries: `/${lang}/industries`,
  pdfIncentive: `/documents/${lang}/incentives-guide-2025.pdf`
};

const mainPillars = [
  { id: 'economy', key: 'why.biz', img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab', num: '#1' },
  { id: 'fundamental', key: 'why.fundamental', img: 'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e', num: '#2' },
  { id: 'sustainable', key: 'why.sustainable', img: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d', num: '#3' },
  { id: 'stories', key: 'why.stories', img: 'https://images.unsplash.com/photo-1556761175-b413da4baf72', num: '#4' }
];

const industriesList = [
  { key: 'machinery', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>` },
  { key: 'energy', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
  { key: 'semiconductor', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"/></svg>` },
  { key: 'tourism', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8 11h8M12 8v6"/></svg>` },
  { key: 'bio', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c0 4.14 3.36 7.5 7.5 7.5s7.5-3.36 7.5-7.5c0-4.03-3.23-7.5-7.5-7.5-1.14 0-2.22.25-3.18.72"/><path d="M12 9V1M12 21v-4M9 12l-3-3M18 12l-3 3"/></svg>` },
  { key: 'robot', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4M8 16h.01M16 16h.01"/><path d="M9 11V9a3 3 0 0 1 6 0v2"/></svg>` },
  { key: 'shipbuilding', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17l20 0l-2 4l-16 0z"/><path d="M5 17l0-10l14 0l0 10"/><path d="M12 7l0-4"/></svg>` },
  { key: 'ict', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>` }
];

const featureStories = [
  { id: 'f1', key: 'home.feat_1', date: '2025.12.04', img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab' },
  { id: 'f2', key: 'home.feat_2', date: '2025.11.07', img: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d' },
  { id: 'f3', key: 'home.feat_3', date: '2025.10.01', img: 'https://images.unsplash.com/photo-1497366216548-37526070297c' }
];
---

<Layout title={t('nav.why')} lang={lang}>
  <main class="bg-white antialiased">
    <section class="pt-12 pb-0 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <nav class="text-sm text-gray-400 mb-8 font-bold uppercase tracking-widest">
          <a href={paths.home} class="hover:text-gray-900 transition-colors">Trang chủ</a> · <span class="text-gray-900">{t('why.title')}</span>
        </nav>
        <h1 class="text-4xl sm:text-5xl md:text-[80px] font-black text-[#111] tracking-tighter leading-tight md:leading-none mb-12 uppercase not-italic">
          {t('why.title')}
        </h1>
      </div>
      <div class="w-full h-[450px] overflow-hidden shadow-inner">
        <img src="https://images.unsplash.com/photo-1538481199705-c710c4e965fc" class="w-full h-full object-cover" alt="KOREA Panorama" />
      </div>
    </section>

    <section class="py-24 px-6 max-w-7xl mx-auto">
      <div class="pillar-wrapper">
        {mainPillars.map((item) => (
          <a href={`/${lang}/why-korea/${item.id}`} class="pillar-card group">
            
            <img src={item.img} class="pillar-img" />

            <div class="overlay"></div>

            <div class="content-top">
              <span class="num">{item.num}</span>
              <h3>{t(item.key)}</h3>
            </div>

            <div class="content-bottom">
              <div class="btn">
                {t('why.move_page') || 'XEM CHI TIẾT'} →
              </div>
            </div>

          </a>
        ))}
      </div>
    </section>

    <section class="py-32 bg-[#f8f9fa] border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 items-start gap-12 text-left">
          <div class="lg:col-span-8">
            <h2 class="text-3xl md:text-[56px] font-black text-[#111] leading-[1.05] mb-12 uppercase tracking-tighter not-italic">
              {t('why.incentive_title_1')} <br/> 
              {t('why.incentive_title_2')} <br/>
              {t('why.incentive_title_3')} <span class="text-[#ee5931]">{t('why.incentive_title_orange')}</span>
            </h2>
          </div>
          <div class="lg:col-span-4 lg:pt-4">
            <p class="text-gray-500 text-[16px] leading-relaxed mb-10 font-bold text-left not-italic">
              {t('why.incentive_desc')}
            </p>
            <a href={paths.pdfIncentive} download class="bg-[#ee5931] text-white px-10 py-5 rounded-md font-black uppercase tracking-tighter hover:bg-[#d44d28] transition-all inline-flex items-center gap-4 text-lg shadow-xl group w-fit">
              {t('why.download_btn')} <span class="group-hover:translate-x-2 transition-transform">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-24 px-6 max-w-7xl mx-auto">
      <h2 class="text-[36px] font-black text-[#111] tracking-tighter mb-16 text-left uppercase not-italic">
        {t('home.other_ind')}
      </h2>
      <div class="relative">
        <div id="ind-slider" class="flex flex-nowrap overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide gap-px bg-gray-200 border border-gray-200 shadow-sm">
          {industriesList.map(item => (
            <a href={`${paths.industries}/${item.key}`} class="bg-white p-10 flex flex-col justify-between h-52 hover:bg-[#003366] transition-all group snap-start min-w-[50%] md:min-w-[25%] block">
              <div class="w-12 h-12 text-gray-400 group-hover:text-white transition-all duration-300" set:html={item.svg} />
              <div class="flex justify-between items-end text-left">
                <span class="text-sm font-black text-gray-700 group-hover:text-white uppercase tracking-tight leading-tight w-2/3 block not-italic">
                  {t(`ind.${item.key}`)}
                </span>
                <span class="text-gray-300 group-hover:text-white transition-all text-xl">→</span>
              </div>
            </a>
          ))}
        </div>
        <div class="flex justify-center gap-4 mt-12">
          <button id="ind-prev" class="slider-arrow">←</button>
          <button id="ind-next" class="slider-arrow">→</button>
        </div>
      </div>
    </section>

    <section class="py-24 border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <h2 class="text-[36px] font-black text-[#111] mb-20 tracking-tighter text-left uppercase not-italic">Feature Stories</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-16 mb-20">
          {featureStories.map(f => (
            <a href={`${paths.news}/${f.id}`} class="group cursor-pointer block text-left">
              <div class="aspect-[16/10] rounded-2xl overflow-hidden mb-8 shadow-md ring-1 ring-black/5">
                <img src={f.img} class="w-full h-full object-cover transition-all duration-700 group-hover:scale-105" alt={t(f.key)} />
              </div>
              <p class="text-[17px] font-black text-gray-900 leading-snug mb-4 group-hover:text-[#ee5931] transition-colors line-clamp-3 text-left not-italic">
                {t(f.key)}
              </p>
              <span class="text-xs text-gray-400 font-bold tracking-widest uppercase block text-left not-italic italic">{f.date}</span>
            </a>
          ))}
        </div>
        <div class="flex justify-center">
          <a href={paths.news} class="px-16 py-4 border-2 border-gray-100 text-gray-400 font-black uppercase text-[12px] tracking-[0.3em] hover:bg-[#111] hover:text-white hover:border-[#111] transition-all active:scale-95 not-italic">
            {t('home.btn_more') || 'XEM THÊM +'}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.pillar-wrapper {
  display: flex;
  gap: 16px;
  height: 650px;
}
.slider-arrow {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    background: white;
    cursor: pointer;
    font-size: 1.25rem;
  }
.slider-arrow:hover { 
    background: #111; 
    color: white; 
    border-color: #111;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
.slider-arrow:active { transform: scale(0.95); }

/* CARD */
.pillar-card {
  position: relative;
  flex: 1;
  border-radius: 32px;
  overflow: hidden;
  cursor: pointer;
  transition: all 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  will-change: flex, transform;
}

/* 👇 Khi hover container */
.pillar-wrapper:hover .pillar-card {
  flex: 0.7;
}

/* 👇 Card đang hover */
.pillar-wrapper .pillar-card:hover {
  flex: 3;
  transform: scale(1.02);
  z-index: 2;
}

/* IMAGE */
.pillar-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
}

.pillar-card:hover .pillar-img {
  transform: scale(1.1);
}

/* OVERLAY */
.overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.3), transparent, rgba(0,0,0,0.7));
  transition: opacity 0.6s ease;
}

.pillar-card:hover .overlay {
  opacity: 0.9;
}

/* TEXT TOP */
.content-top {
  position: absolute;
  top: 48px;
  left: 40px;
  color: white;
  z-index: 2;
}

.content-top .num {
  font-size: 20px;
  font-weight: 900;
  opacity: 0.8;
}

.content-top h3 {
  font-size: 30px;
  font-weight: 900;
  margin-top: 8px;
  transition: all 0.4s ease;
}

/* 👇 Card không hover */
.pillar-wrapper:hover .pillar-card:not(:hover) h3 {
  font-size: 24px;
  opacity: 0.6;
}

/* BUTTON */
.content-bottom {
  position: absolute;
  bottom: 48px;
  left: 40px;
  opacity: 0;
  transform: translateY(30px);
  transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
}

.pillar-card:hover .content-bottom {
  opacity: 1;
  transform: translateY(0);
}

.btn {
  background: #ee5931;
  color: white;
  padding: 14px 32px;
  border-radius: 12px;
  font-weight: 900;
  transition: all 0.3s ease;
}

.pillar-card:hover .btn {
  background: white;
  color: #ee5931;
}
.scrollbar-hide::-webkit-scrollbar {
  display: none; /* Chrome, Safari */
}

.scrollbar-hide {
  -ms-overflow-style: none;  /* IE, Edge cũ */
  scrollbar-width: none;     /* Firefox */
}
/* Mobile */
@media (max-width: 768px) {
  .pillar-wrapper {
    flex-direction: column;
    height: auto !important;
    gap: 20px;
  }

  .pillar-card {
    height: 350px !important;
    flex: none !important;
    width: 100%;
  }
}
</style>

<script>
  function setupSlider() {
    const slider = document.getElementById('ind-slider');
    const prev = document.getElementById('ind-prev') as HTMLButtonElement | null;
    const next = document.getElementById('ind-next') as HTMLButtonElement | null;

    if (slider && prev && next) {
      const scrollAmount = 350;
      next.onclick = () => slider.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      prev.onclick = () => slider.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
    }
  }

  document.addEventListener('astro:page-load', setupSlider);
  document.addEventListener('DOMContentLoaded', setupSlider);
</script>