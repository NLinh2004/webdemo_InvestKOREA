---
import Layout from '../../../layouts/Layout.astro';
import ComingSoon from '../../../components/ComingSoon.astro';
import { useTranslations } from '../../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { slug: 'guide' } },
    { params: { slug: 'consulting' } },
    { params: { slug: 'living' } },
    { params: { slug: 'faq' } },
  ];
}

const { slug } = Astro.params;
const lang = 'vi';
const t = useTranslations(lang);

// Lấy tên section từ slug để hiển thị cho thân thiện
const sectionNames: Record<string, string> = {
  guide: 'Hướng dẫn đầu tư',
  consulting: 'Dịch vụ tư vấn',
  living: 'Hỗ trợ định cư',
  faq: 'Câu hỏi thường gặp'
};

const sectionTitle = sectionNames[slug as string] || 'Dịch vụ';
---

<Layout title={`${sectionTitle} - Invest KOREA`} lang={lang}>
  <main class="bg-white">
    <ComingSoon lang={lang} section={sectionTitle} />
  </main>
</Layout>
