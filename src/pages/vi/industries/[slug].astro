---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';
// Kiểm tra kỹ đuôi file .ts hoặc .js
import { industriesContent } from '../../../data/industries_content'; 

export async function getStaticPaths() {
  const industries = ['semiconductor', 'aerospace', 'automobile', 'battery']; // Danh sách các slug bạn đã tạo dữ liệu
  return industries.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const lang = 'vi';
const t = useTranslations(lang);

// Lấy dữ liệu và xử lý trường hợp slug không tồn tại để tránh lỗi crash trang
const content = industriesContent[lang][slug] || industriesContent[lang]['semiconductor']; 
---

<Layout title={`${content.heroTitle} | Invest KOREA`} lang={lang}>
  <main class="bg-white">
    <section class="pt-24 pb-12 px-6 max-w-6xl mx-auto text-left">
      <nav class="text-[13px] text-gray-400 mb-6 font-bold italic uppercase tracking-wider">
        <a href={`/${lang}`} class="hover:text-gray-900">Trang chủ</a> · 
        <a href={`/${lang}/industries`} class="hover:text-gray-900">{t('ind.title')}</a> · 
        <span class="text-gray-900">{content.heroTitle}</span>
      </nav>
      <h1 class="text-[64px] font-black text-[#111] uppercase italic tracking-tighter leading-none">{content.heroTitle}</h1>
    </section>

    <section class="w-full h-[500px] overflow-hidden bg-gray-100 mb-20 shadow-inner">
      <img src={content.heroImg} class="w-full h-full object-cover" alt={content.heroTitle} />
    </section>

    <section class="py-24">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center gap-16 text-left">
        <div class="flex-1 space-y-8">
          <h2 class="text-[42px] font-black text-[#003366] italic uppercase tracking-tighter leading-tight">{content.section1Title}</h2>
          <p class="text-gray-500 font-bold italic leading-relaxed text-lg">{content.section1Desc}</p>
        </div>
        <div class="flex-1 rounded-[32px] overflow-hidden shadow-2xl border border-gray-100">
          <img src={content.section1Img} class="w-full h-[450px] object-cover" />
        </div>
      </div>
    </section>
  </main>
</Layout>