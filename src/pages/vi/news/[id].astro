---
import Layout from '../../../layouts/Layout.astro';
import { useTranslations } from '../../../i18n/utils';

// 1. Astro yêu cầu hàm này cho file có tên [id].astro
export function getStaticPaths() {
  return [
    { params: { id: 'feat_1' } },
    { params: { id: 'feat_2' } },
    { params: { id: 'feat_3' } },
    { params: { id: 'm-name' } },
    { params: { id: 'e-name' } },
  ];
}

const { id } = Astro.params;
const lang = 'vi'; // Gán cứng vì file nằm trong thư mục /vi/
const t = useTranslations(lang);
---

<Layout title={`${t(`home.${id}`)} | Invest KOREA`} lang={lang}>
  <main class="bg-white antialiased">
    <article class="pt-32 pb-16 px-6 max-w-4xl mx-auto text-left">
      
      <nav class="mb-6 text-[11px] font-bold uppercase tracking-widest text-gray-400">
        <a href="/vi/" class="hover:text-[#ee5931]">{t('nav.breadcrumb_home')}</a>
        <span class="mx-2">/</span>
        <a href="/vi/news" class="hover:text-[#ee5931]">{t('home.feature_title')}</a>
      </nav>

      <h1 class="text-4xl md:text-5xl font-black text-[#111] leading-tight mb-6 tracking-tighter not-italic">
        {t(`home.${id}`)}
      </h1>

      <div class="w-full aspect-video bg-gray-100 rounded-2xl mb-10 overflow-hidden shadow-sm">
        <img 
          src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab" 
          class="w-full h-full object-cover" 
          alt="News Banner" 
        />
      </div>

      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed font-medium not-italic">
        <p>Nội dung chi tiết cho bài viết này sẽ được cập nhật sớm. Hiện tại hệ thống đang kết nối dữ liệu cho mã định danh: <strong>{id}</strong>.</p>
      </div>

      <div class="mt-16 pt-8 border-t border-gray-100 text-center">
        <a href="/vi/news" class="inline-block px-10 py-3 border-2 border-[#111] text-[#111] font-black uppercase text-[12px] tracking-widest hover:bg-[#111] hover:text-white transition-all not-italic">
          Quay lại danh sách
        </a>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* Fix khoảng cách chữ và phông đứng */
  main * { font-style: normal !important; letter-spacing: -0.015em; }
</style>