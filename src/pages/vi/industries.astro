---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'vi';
const t = useTranslations(lang);

// Chia danh sách ngành làm 2 cột
const col1 = ['news', 'aerospace', 'battery', 'creative', 'finance', 'ict', 'machinery', 'energy', 'semiconductor', 'tourism'];
const col2 = ['startup', 'automotive', 'consumer', 'display', 'chemical', 'logistics', 'bio', 'robot', 'shipbuilding'];
---

<Layout title="Thông tin ngành" lang={lang}>
  <main class="bg-white min-h-screen">
    <div class="border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 py-4 text-[12px] font-bold text-gray-400 uppercase">
        Trang chủ <span class="mx-2">/</span> Thông tin ngành
      </div>
    </div>

    <section class="max-w-7xl mx-auto px-6 py-20 flex flex-col lg:flex-row gap-20">
      <div class="lg:w-1/4">
        <h1 class="text-[64px] font-black italic uppercase leading-none tracking-tighter text-[#003366]">
          Industries
        </h1>
      </div>

      <div class="lg:w-3/4 grid grid-cols-1 md:grid-cols-2 gap-x-16">
        <div class="flex flex-col">
          {col1.map((key) => (
            <a href="#" class="group py-4 border-b border-gray-50 flex justify-between items-center hover:bg-gray-50 transition-all">
              <span class="text-[17px] font-bold text-gray-800 group-hover:text-[#ee5931]">
                {t(`ind.${key}`)}
              </span>
              <span class="text-[#ee5931] opacity-0 group-hover:opacity-100 transition-all">→</span>
            </a>
          ))}
        </div>
        <div class="flex flex-col">
          {col2.map((key) => (
            <a href="#" class="group py-4 border-b border-gray-50 flex justify-between items-center hover:bg-gray-50 transition-all">
              <span class="text-[17px] font-bold text-gray-800 group-hover:text-[#ee5931]">
                {t(`ind.${key}`)}
              </span>
              <span class="text-[#ee5931] opacity-0 group-hover:opacity-100 transition-all">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>