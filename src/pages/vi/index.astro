---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'vi'; 
const t = useTranslations(lang);

const paths = {
  economy: `/${lang}/why-korea/economy`,
  industries: `/${lang}/industries`,
  regions: `/${lang}/regions`,
  news: `/${lang}/news`,
  pdfGuide: `/documents/${lang}/invest-guide.pdf`
};

/** * 1. THAY ĐỔI: Chuyển đổi industriesList từ Emoji sang SVG 
 * Sử dụng stroke="currentColor" để Icon tự đổi màu theo chữ khi hover.
 */
const industriesList = [
  { 
    key: 'machinery', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>` 
  },
  { 
    key: 'energy', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` 
  },
  { 
    key: 'semiconductor', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"/></svg>` 
  },
  { 
    key: 'tourism', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8 11h8M12 8v6"/></svg>` 
  },
  { 
    key: 'bio', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c0 4.14 3.36 7.5 7.5 7.5s7.5-3.36 7.5-7.5c0-4.03-3.23-7.5-7.5-7.5-1.14 0-2.22.25-3.18.72"/><path d="M12 9V1M12 21v-4M9 12l-3-3M18 12l-3 3"/></svg>` 
  },
  { 
    key: 'robot', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4M8 16h.01M16 16h.01"/><path d="M9 11V9a3 3 0 0 1 6 0v2"/></svg>` 
  },
  { 
    key: 'shipbuilding', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17l20 0l-2 4l-16 0z"/><path d="M5 17l0-10l14 0l0 10"/><path d="M12 7l0-4"/></svg>` 
  },
  { 
    key: 'ict', 
    svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>` 
  }
];

const successStories = [
  { id: 'm-name', nameKey: 'home.success_m_name', descKey: 'home.success_m_desc', img: '/images/success_1.png' },
  { id: 'e-name', nameKey: 'home.success_e_name', descKey: 'home.success_e_desc', img: '/images/success_2.png' }
];

const features = [
  { id: 'f1', date: '2025.12.04', key: 'home.feat_1', img: '/images/news_tech.png' },
  { id: 'f2', date: '2025.11.07', key: 'home.feat_2', img: '/images/news_policy.png' },
  { id: 'f3', date: '2025.10.01', key: 'home.feat_3', img: '/images/success_1.png' }
];
---

<Layout title={t('home.title')} lang={lang}>
  <main class="bg-white antialiased">
    
    <section class="w-full">
      <div class="pt-10 pb-10 px-6 max-w-7xl mx-auto text-left">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-[#111] tracking-tighter leading-[1.1] mb-6 not-italic">
          {t('home.hero_title')} <span class="text-[#ee5931]">Korea</span>
        </h1>
        <p class="text-gray-500 text-sm md:text-base max-w-full sm:max-w-md font-medium leading-relaxed not-italic">
          {t('home.hero_subtitle')}
        </p>
      </div>
      <div class="w-full h-[600px] overflow-hidden shadow-inner">
        <img src="/images/hero_korea.png" class="w-full h-full object-cover block" alt="Korea" />
      </div>
    </section>

    <section class="py-24 bg-white border-b border-gray-100 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <h2 class="text-3xl md:text-4xl font-black text-[#003366] tracking-tighter mb-4 not-italic leading-tight">
          {t('home.eco_title')}
        </h2>
        <p class="text-gray-500 max-w-2xl mb-16 leading-relaxed font-medium">
          {t('home.eco_desc')}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div class="border-l-4 border-[#ee5931] pl-6 transition-transform hover:translate-x-2">
            <span class="text-[10px] md:text-xs uppercase tracking-widest text-[#ee5931] font-bold">
              {t('home.eco_rating_label')}
            </span>
            <p class="text-4xl md:text-5xl font-black text-[#111] mt-2 tracking-tighter italic">
              {t('home.eco_rating_value')}
            </p>
          </div>
          
          <div class="border-l-4 border-[#ee5931] pl-6 transition-transform hover:translate-x-2">
            <span class="text-[10px] md:text-xs uppercase tracking-widest text-[#ee5931] font-bold">
              {t('home.eco_gdp_label')}
            </span>
            <p class="text-4xl md:text-5xl font-black text-[#111] mt-2 tracking-tighter">
              {t('home.eco_gdp_value')}
            </p>
          </div>

          <div class="border-l-4 border-[#ee5931] pl-6 transition-transform hover:translate-x-2">
            <span class="text-[10px] md:text-xs uppercase tracking-widest text-[#ee5931] font-bold">
              {t('home.eco_trade_label')}
            </span>
            <p class="text-4xl md:text-5xl font-black text-[#111] mt-2 tracking-tighter">
              {t('home.eco_trade_value')}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-16 md:py-24 bg-gray-50 border-b border-gray-100 overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <h2 class="text-3xl md:text-5xl font-black text-[#003366] tracking-tighter mb-12 not-italic leading-tight lg:w-2/3">
          {t('home.complex_title')}
        </h2>
        
        <div class="flex flex-col md:flex-row gap-12 lg:gap-20 items-center">
          <div class="w-full md:w-1/2 order-2 md:order-1">
            <p class="text-[#ee5931] font-black mb-4 uppercase tracking-[0.2em] text-xs">
              {t('home.complex_subtitle')}
            </p>
            <p class="text-gray-600 leading-relaxed font-semibold text-lg mb-8 max-w-xl">
              {t('home.complex_desc')}
            </p>

            <ul class="space-y-4 mb-12">
               {[1, 2, 3, 4].map(i => (
                 <li class="flex items-start gap-4 group">
                    <div class="w-6 h-6 bg-white rounded-full shadow-sm flex items-center justify-center shrink-0 mt-0.5 group-hover:bg-[#ee5931] transition-colors">
                      <svg class="w-3.5 h-3.5 text-[#ee5931] group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="4" viewBox="0 0 24 24">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </div>
                    <span class="text-gray-700 font-bold text-sm md:text-md tracking-tight leading-snug">{t(`home.complex_benefit_${i}`)}</span>
                 </li>
               ))}
            </ul>

            <a href={paths.industries} class="inline-flex items-center gap-4 px-10 py-4 bg-[#003366] text-white font-black text-xs uppercase tracking-widest rounded-xl hover:bg-[#ee5931] hover:shadow-[0_10px_30px_rgba(238,89,49,0.3)] transition-all shadow-xl active:scale-95 group">
               {t('regions.btn_text')}
               <span class="text-xl group-hover:translate-x-2 transition-transform">→</span>
            </a>
          </div>
          
          <div class="w-full md:w-1/2 order-1 md:order-2">
            <div class="relative rounded-[2.5rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.1)] ring-1 ring-gray-200 aspect-[4/3] md:h-[520px]">
              <img src="/images/industrial_complex.png" 
                  class="w-full h-full object-cover hover:scale-110 transition-transform duration-1000 ease-out" 
                  alt="Industrial Complex" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-24 px-6 max-w-7xl mx-auto overflow-x-hidden">
      <h2 class="text-2xl sm:text-3xl md:text-[56px] font-black text-[#003366] tracking-tighter mb-10 md:mb-16 text-left not-italic uppercase leading-[1.1]">{t('home.other_ind')}</h2>
      <div id="ind-slider" class="flex flex-nowrap overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide">
        <div class="min-w-full flex-shrink-0 snap-start grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
          {industriesList.map(item => (
            <a href={`${paths.industries}/${item.key}`} class="bg-white p-6 md:p-10 flex flex-col justify-between min-h-[160px] md:h-52 hover:bg-[#003366] transition-all group">
              
              <div class="w-10 h-10 text-gray-400 group-hover:text-white transition-all duration-300" set:html={item.svg} />
              
              <div class="flex justify-between items-end text-left">
                <span class="text-sm font-black text-gray-700 group-hover:text-white uppercase tracking-tight leading-tight w-2/3 block not-italic">
                  {t(`ind.${item.key}`)}
                </span>
                <span class="text-gray-300 group-hover:text-white transition-all text-xl">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
      <div class="flex justify-center gap-4 mt-12">
        <button id="ind-prev" class="slider-arrow">←</button>
        <button id="ind-next" class="slider-arrow">→</button>
      </div>
    </section>

    <section class="py-16 bg-white border-t border-gray-100 overflow-hidden">
      <div class="container mx-auto px-6 max-w-7xl">
        <h2 class="text-3xl md:text-4xl font-black text-[#003366] tracking-tighter mb-10 text-left not-italic uppercase leading-tight">
          {t('home.success_title')}
        </h2>
        
        <div id="success-slider" class="flex gap-8 overflow-x-auto scroll-smooth scrollbar-hide snap-x">
          {successStories.map(story => (
            /* Thay đổi thẻ <a> thành <button> để mở Modal thay vì chuyển trang */
            <button 
              class="news-modal-trigger min-w-full md:min-w-[calc(50%-16px)] group cursor-pointer snap-start block text-left bg-transparent border-none p-0"
              data-title={t(story.nameKey)}
              data-desc={t(story.descKey)}
              data-img={story.img}
              data-id={story.id}
            >
              <div class="aspect-[16/10] bg-gray-100 rounded-2xl overflow-hidden mb-6 shadow-md border border-gray-100">
                <img src={story.img} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-700" alt={t(story.nameKey)} />
              </div>
              <h3 class="text-xl md:text-2xl font-black mb-2 tracking-tighter text-[#111] group-hover:text-[#ee5931] transition-colors not-italic uppercase leading-tight">
                {t(story.nameKey)}
              </h3>
              <p class="text-gray-400 text-sm line-clamp-2 not-italic">
                {t(story.descKey)}
              </p>
            </button>
          ))}
        </div>
        
        <div class="flex justify-center gap-4 mt-10">
          <button id="success-prev" class="slider-arrow">←</button>
          <button id="success-next" class="slider-arrow">→</button>
        </div>
      </div>
    </section>

    <div id="news-popup" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
      <div class="bg-white w-full max-w-2xl rounded-[2.5rem] overflow-hidden shadow-2xl relative">
        <button id="popup-close" class="absolute top-8 right-8 text-gray-400 hover:text-black z-10 text-2xl">✕</button>
        
        <div class="p-8 md:p-12 overflow-y-auto max-h-[90vh] scrollbar-hide text-left">
          <h2 id="popup-title" class="text-2xl md:text-3xl font-black text-[#111] mb-8 pr-10 leading-tight tracking-tighter not-italic uppercase"></h2>
          
          <div class="rounded-2xl overflow-hidden mb-8 aspect-video shadow-lg">
            <img id="popup-img" src="" class="w-full h-full object-cover" alt="Detail" />
          </div>
          
          <div id="popup-content" class="text-gray-600 leading-relaxed font-medium space-y-4 text-base md:text-lg not-italic">
            </div>
        </div>
      </div>
    </div>

    <section class="py-24 bg-white border-t border-gray-50 px-6 max-w-7xl mx-auto text-left overflow-x-hidden">
      <div class="flex flex-col lg:flex-row gap-16 mb-12 items-start">
        <div class="lg:w-1/4 text-left">
          <h2 class="text-3xl md:text-5xl font-black text-[#003366] tracking-tighter mb-6 not-italic uppercase leading-tight">{t('regions.title')}</h2>
          <p class="text-gray-500 mb-10 leading-relaxed ">{t('regions.description')}</p>
          <a href={paths.regions} class="inline-flex items-center justify-between bg-[#ee5931] text-white px-8 py-4 rounded-md font-bold uppercase hover:bg-[#d44d28] transition-all w-fit shadow-lg not-italic">
            <span>{t('regions.btn_text')}</span> <span class="ml-4 text-xl">→</span>
          </a>
        </div>
        <div id="reg-slider" class="lg:w-3/4 flex gap-4 overflow-x-auto scroll-smooth scrollbar-hide snap-x relative w-full">
          {[
            { name: 'Seoul', img: '/images/regions/seoul.png' },
            { name: 'Incheon', img: '/images/hero_korea.png' },
            { name: 'Gyeonggi', img: '/images/industrial_complex.png' },
            { name: 'Busan', img: '/images/regions/busan.png' }
          ].map(city => (
            <a href={`${paths.regions}/${city.name.toLowerCase()}`} class="min-w-[280px] xs:min-w-[320px] h-[400px] md:h-[450px] rounded-2xl relative overflow-hidden group cursor-pointer snap-start block text-left">
              <img src={city.img} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" alt={city.name} />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent"></div>
              <span class="absolute bottom-10 left-10 text-white text-2xl md:text-3xl font-black tracking-tighter not-italic uppercase">{city.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

   <section class="py-16 bg-white border-t border-gray-100 overflow-hidden">
      <div class="container mx-auto px-6 text-left max-w-7xl">
        <h2 class="text-2xl md:text-3xl font-black text-[#003366] mb-12 tracking-tighter not-italic uppercase leading-tight">
          {t('home.feature_title')}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
          {features.map(f => (
            /* Tin tức nổi bật cũng dẫn về trang chi tiết tương ứng */
            <a href={`/vi/news/${f.id}`} class="group cursor-pointer block text-left">
              <div class="aspect-video rounded-xl overflow-hidden mb-6 bg-gray-200 shadow-sm">
                <img src={f.img} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" />
              </div>
              <p class="text-[16px] font-bold text-gray-800 leading-snug mb-3 group-hover:text-[#ee5931] transition-colors line-clamp-2 not-italic">
                {t(f.key)}
              </p>
              <span class="text-xs text-gray-400 font-bold uppercase tracking-widest not-italic italic">
                {f.date}
              </span>
            </a>
          ))}
        </div>

        <div class="flex justify-center">
          <a 
            href="/vi/news" 
            class="px-14 py-4 border-2 border-gray-100 text-gray-400 font-black uppercase text-[11px] tracking-[0.2em] hover:bg-[#111] hover:text-white hover:border-[#111] transition-all active:scale-95 not-italic italic"
          >
            {t('home.btn_more')}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  #ind-slider, #success-slider, #reg-slider { cursor: grab; }

  .slider-arrow {
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    background: white;
    cursor: pointer;
    font-size: 1.25rem;
  }
  .slider-arrow:hover { background: #111; color: white; border-color: #111; }
  .slider-arrow:active { transform: scale(0.9); }
</style>

<script>
  function initAll() {
    // 1. Sửa lỗi Implicit 'any' bằng cách thêm kiểu string cho tham số
    const initSlider = (sliderId: string, prevId: string, nextId: string, scrollOffset: number = 0) => {
      const slider = document.getElementById(sliderId);
      // Ép kiểu Element sang HTMLElement để sử dụng thuộc tính onclick
      const prev = document.getElementById(prevId) as HTMLElement | null;
      const next = document.getElementById(nextId) as HTMLElement | null;

      if (slider && prev && next) {
        next.onclick = () => slider.scrollBy({ left: scrollOffset || slider.offsetWidth / 2, behavior: 'smooth' });
        prev.onclick = () => slider.scrollBy({ left: -(scrollOffset || slider.offsetWidth / 2), behavior: 'smooth' });
      }
    };

    initSlider('ind-slider', 'ind-prev', 'ind-next', 350);
    initSlider('success-slider', 'success-prev', 'success-next');
    initSlider('reg-slider', 'reg-prev', 'reg-next', 336);

    // 2. Khởi tạo Modal với kiểu dữ liệu an toàn
    const modal = document.getElementById('news-popup') as HTMLElement | null;
    const closeBtn = document.getElementById('popup-close') as HTMLElement | null;
    const triggers = document.querySelectorAll('.news-modal-trigger');

    const pTitle = document.getElementById('popup-title') as HTMLElement | null;
    const pImg = document.getElementById('popup-img') as HTMLImageElement | null; // Sửa lỗi 'src' does not exist
    const pContent = document.getElementById('popup-content') as HTMLElement | null;

    triggers.forEach(trigger => {
      const el = trigger as HTMLElement;
      el.onclick = function() {
        // Sửa lỗi gán 'string | null' vào 'string' bằng toán tử || ''
        const title = el.getAttribute('data-title') || '';
        const desc = el.getAttribute('data-desc') || '';
        const img = el.getAttribute('data-img') || '';
        
        if (pTitle) pTitle.innerText = title;
        if (pImg) pImg.src = img; // Bây giờ thuộc tính src đã hợp lệ
        if (pContent) pContent.innerText = desc;
        
        modal?.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      };
    });

    const closeModal = () => {
      modal?.classList.add('hidden');
      document.body.style.overflow = 'auto';
    };

    if (closeBtn) closeBtn.onclick = closeModal;
    
    if (modal) {
      modal.onclick = (e) => {
        if (e.target === modal) closeModal();
      };
    }
  }

  // Đảm bảo Script chạy lại khi Astro chuyển trang
  document.addEventListener('astro:page-load', initAll);
  // Dự phòng cho lần tải trang đầu tiên
  document.addEventListener('DOMContentLoaded', initAll);
</script>