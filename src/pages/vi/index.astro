---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const t = useTranslations('vi');
---

<Layout title={t('hero.title')} lang="vi">
  <main class="bg-white">
    
    <section class="relative h-[650px] flex items-center overflow-hidden">
      <div class="absolute inset-0 z-0 bg-[#001529]">
        <img 
          src="https://images.unsplash.com/photo-1540331547168-8b63109225b7?q=80&w=2000" 
          class="w-full h-full object-cover opacity-50" 
          alt="Korea Landscape" 
        />
      </div>
      
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl">
          <h1 class="text-6xl md:text-8xl font-light text-white mb-8 leading-[1.05] tracking-tighter">
            Finding Business <br/>
            Opportunities in <strong class="font-black text-[#ff4d4d]">Korea</strong>
          </h1>
          <p class="text-xl text-white/80 mb-10 max-w-xl leading-relaxed">
            {t('hero.description')}
          </p>
        </div>
      </div>
    </section>

    <section class="bg-white py-24 border-b border-gray-100">
      <div class="container mx-auto px-6">
        <div class="max-w-4xl mb-20">
          <h2 class="text-4xl font-black text-[#003366] leading-tight uppercase tracking-tighter">
            <span class="text-[#ff4d4d]">Korea</span>'s Solid <br/> Economic Fundamentals
          </h2>
          <div class="w-16 h-1 bg-[#ff4d4d] mt-6"></div>
          <p class="mt-8 text-gray-500 max-w-3xl text-lg leading-relaxed italic">
            "Sức mạnh kinh tế vững chắc của Hàn Quốc phản ánh qua các ngành công nghiệp đổi mới sáng tạo và thương mại toàn cầu mạnh mẽ."
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-16">
          <div class="flex items-end gap-6 border-b border-gray-100 pb-8 md:border-0 md:pb-0">
            <div class="flex flex-col">
              <span class="text-[11px] font-black text-[#ff4d4d] uppercase mb-1 leading-tight w-24">Sovereign Credit Rating</span>
              <span class="text-7xl font-black tracking-tighter text-[#111]">Aa2</span>
            </div>
          </div>
          <div class="flex items-end gap-6 border-b border-gray-100 pb-8 md:border-0 md:pb-0">
            <div class="flex flex-col">
              <span class="text-[11px] font-black text-[#ff4d4d] uppercase mb-1 leading-tight">GDP</span>
              <span class="text-7xl font-black tracking-tighter text-[#111]">12th</span>
            </div>
          </div>
          <div class="flex items-end gap-6">
            <div class="flex flex-col">
              <span class="text-[11px] font-black text-[#ff4d4d] uppercase mb-1 leading-tight">Trade</span>
              <span class="text-7xl font-black tracking-tighter text-[#111]">9th</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-[#f8f9fa] py-24">
      <div class="container mx-auto px-6">
        <div class="flex justify-between items-center mb-16">
          <h2 class="text-3xl font-black text-[#003366] uppercase tracking-tighter">Other Industries</h2>
          <div class="flex gap-2">
            <button class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center hover:bg-white">←</button>
            <button class="w-10 h-10 rounded-full border border-gray-300 flex items-center justify-center hover:bg-white">→</button>
          </div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-gray-200 border border-gray-200">
          {[
            { name: 'Aerospace', icon: '✈️' },
            { name: 'Battery', icon: '🔋' },
            { name: 'Cultural Content', icon: '🎬' },
            { name: 'Finance', icon: '📈' },
            { name: 'Automobile Parts', icon: '⚙️' },
            { name: 'Consumer Goods', icon: '🛍️' },
            { name: 'Display', icon: '📺' },
            { name: 'Fine Chemical', icon: '⚗️' }
          ].map((item) => (
            <a href="#" class="bg-white p-10 flex flex-col justify-between h-40 hover:bg-[#003366] transition-all group">
              <span class="text-3xl grayscale group-hover:grayscale-0 transition-all">{item.icon}</span>
              <div class="flex justify-between items-center">
                <span class="text-sm font-bold text-gray-700 group-hover:text-white uppercase tracking-tight">{item.name}</span>
                <span class="text-gray-300 group-hover:text-white group-hover:translate-x-1 transition-all">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-white py-24">
      <div class="container mx-auto px-6 border-t border-gray-100 pt-20">
        <h2 class="text-3xl font-black text-[#003366] mb-4">Services</h2>
        <p class="text-gray-500 mb-10">Invest KOREA provides services support your investment journey.</p>
        
        <div class="flex flex-wrap gap-4">
          <a href="#" class="flex items-center gap-3 px-8 py-4 border border-[#ff4d4d] text-[#ff4d4d] font-bold text-sm uppercase tracking-widest hover:bg-[#ff4d4d] hover:text-white transition-all">
            <span>Download file</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          </a>
          <a href="#" class="flex items-center gap-3 px-8 py-4 border border-[#ff4d4d] text-[#ff4d4d] font-bold text-sm uppercase tracking-widest hover:bg-[#ff4d4d] hover:text-white transition-all">
            <span>Youtube</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>