---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

// Thiết lập ngôn ngữ
const lang = 'vi'; 
const t = useTranslations(lang);

// Cấu hình đường dẫn thực tế để các sự kiện click hoạt động
const paths = {
  home: `/${lang}`,
  economy: `/${lang}/why-korea/economy`,
  sustainable: `/${lang}/why-korea/sustainable`,
  stories: `/${lang}/why-korea/stories`,
  news: `/${lang}/news`,
  industries: `/${lang}/industries`,
  pdfIncentive: `/documents/${lang}/incentives-guide-2025.pdf`
};

const mainPillars = [
  { id: 'biz', key: 'why.biz', img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab', num: '#1', href: paths.economy },
  { id: 'fundamental', key: 'why.fundamental', img: 'https://images.unsplash.com/photo-1526304640581-d334cdbbf45e', num: '#2', href: paths.economy },
  { id: 'sustainable', key: 'why.sustainable', img: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d', num: '#3', href: paths.sustainable },
  { id: 'stories', key: 'why.stories', img: 'https://images.unsplash.com/photo-1556761175-b413da4baf72', num: '#4', href: paths.stories }
];

// CHỈ THAY ĐỔI TẠI ĐÂY: Chuyển icon Emoji sang mã SVG chuyên nghiệp
const industriesList = [
  { key: 'machinery', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>` },
  { key: 'energy', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>` },
  { key: 'semiconductor', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3"/></svg>` },
  { key: 'tourism', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M8 11h8M12 8v6"/></svg>` },
  { key: 'bio', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c0 4.14 3.36 7.5 7.5 7.5s7.5-3.36 7.5-7.5c0-4.03-3.23-7.5-7.5-7.5-1.14 0-2.22.25-3.18.72"/><path d="M12 9V1M12 21v-4M9 12l-3-3M18 12l-3 3"/></svg>` },
  { key: 'robot', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="10" rx="2"/><circle cx="12" cy="5" r="2"/><path d="M12 7v4M8 16h.01M16 16h.01"/><path d="M9 11V9a3 3 0 0 1 6 0v2"/></svg>` },
  { key: 'shipbuilding', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 17l20 0l-2 4l-16 0z"/><path d="M5 17l0-10l14 0l0 10"/><path d="M12 7l0-4"/></svg>` },
  { key: 'ict', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/></svg>` },
  { key: 'aerospace', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2L16 11l3.5-3.5C21 6 21.5 4 21 3.5s-2.5 0-4 1.5L13.5 8.5l-8.2-1.8c-.9-.2-1.8.3-2 1.2-.2.9.3 1.8 1.2 2l8.9 2.5-3.2 3.2-2.9-.6c-.5-.1-1 .1-1.4.5l-.5.5 4.1 1.9 1.9 4.1.5-.5c.4-.4.6-.9.5-1.4l-.6-2.9 3.2-3.2 2.5 8.9c.2.9 1.1 1.4 2 1.2.9-.2 1.4-1.1 1.2-2z"/></svg>` },
  { key: 'battery', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="16" height="12" rx="2"/><path d="M22 11v2M6 11v2M10 11v2M14 11v2"/></svg>` },
  { key: 'creative', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="18" rx="2"/><path d="M7 3v18M17 3v18M2 7h20M2 12h20M2 17h20"/></svg>` },
  { key: 'finance', svg: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>` }
];

const featureStories = [
  { id: 'fdi-2025-analysis', key: 'home.feat_1', date: '2025.12.04', img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab' },
  { id: 'summit-highlights', key: 'home.feat_2', date: '2025.11.07', img: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d' },
  { id: 'ggfez-investment', key: 'home.feat_3', date: '2025.10.01', img: 'https://images.unsplash.com/photo-1497366216548-37526070297c' }
];
---

<Layout title={t('nav.why')} lang={lang}>
  <main class="bg-white antialiased">
    <section class="pt-12 pb-0 border-b border-gray-100">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <nav class="text-sm text-gray-400 mb-8 font-bold uppercase tracking-widest">
          <a href={paths.home} class="hover:text-gray-900 transition-colors">Trang chủ</a> · <span class="text-gray-900">{t('why.title')}</span>
        </nav>
        <h1 class="text-[80px] font-black text-[#111] tracking-tighter leading-none mb-12 uppercase">
          {t('why.title')}
        </h1>
      </div>
      <div class="w-full h-[450px] overflow-hidden shadow-inner">
        <img src="https://images.unsplash.com/photo-1538481199705-c710c4e965fc" class="w-full h-full object-cover" alt="KOREA Panorama" />
      </div>
    </section>

    <section class="py-24 px-6 max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row gap-4 h-[650px] w-full items-stretch">
        {mainPillars.map((item) => (
          <a href={item.href} class="pillar-card group relative flex-[0.7] h-full rounded-[32px] overflow-hidden cursor-pointer transition-all duration-[800ms] ease-[cubic-bezier(0.2,1,0.3,1)] hover:flex-[3] hover:shadow-2xl">
            <img src={item.img} class="absolute inset-0 w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105" />
            <div class="absolute inset-0 bg-gradient-to-b from-black/40 via-transparent to-black/80"></div>
            <div class="absolute top-12 left-10 text-white z-10 pr-10 text-left">
              <span class="text-xl font-black block mb-2 opacity-80">{item.num}</span>
              <h3 class="text-[34px] font-black leading-tight uppercase tracking-tighter w-[400px] whitespace-nowrap group-hover:whitespace-normal transition-all duration-500">
                {t(item.key)}
              </h3>
            </div>
            <div class="absolute bottom-12 left-10 z-10 opacity-0 translate-y-8 transition-all duration-500 delay-200 group-hover:opacity-100 group-hover:translate-y-0">
              <div class="bg-[#ee5931] text-white px-10 py-4 rounded-xl font-black text-sm uppercase tracking-widest shadow-xl group-hover:bg-white group-hover:text-[#ee5931] transition-all">
                {t('why.move_page')} →
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="py-32 bg-[#f8f9fa]">
      <div class="max-w-7xl mx-auto px-6">
        <div class="grid grid-cols-1 lg:grid-cols-12 items-start gap-12 text-left">
          <div class="lg:col-span-8">
            <h2 class="text-[56px] font-black text-[#111] leading-[1.05] mb-12 uppercase tracking-tighter">
              {t('why.incentive_title_1')} <br/> 
              {t('why.incentive_title_2')} <br/>
              {t('why.incentive_title_3')} <span class="text-[#ee5931]">{t('why.incentive_title_orange')}</span>
            </h2>
          </div>
          <div class="lg:col-span-4 lg:pt-4">
            <p class="text-gray-500 text-[16px] leading-relaxed mb-10 font-bold text-left">
              {t('why.incentive_desc')}
            </p>
            <a href={paths.pdfIncentive} download class="bg-[#ee5931] text-white px-10 py-5 rounded-md font-black uppercase tracking-tighter hover:bg-[#d44d28] transition-all inline-flex items-center gap-4 text-lg shadow-xl group w-fit">
              {t('why.download_btn')} <span class="group-hover:translate-x-2 transition-transform">→</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-white py-24 px-6 max-w-7xl mx-auto">
      <h2 class="text-[36px] font-black text-[#111] tracking-tighter mb-16 text-left">{t('home.other_ind')}</h2>
      <div class="relative group">
        <div id="ind-slider" class="flex flex-nowrap overflow-x-auto scroll-smooth snap-x snap-mandatory scrollbar-hide gap-px bg-gray-200 border border-gray-200">
          {industriesList.map(item => (
            <a href={`${paths.industries}/${item.key}`} class="bg-white p-10 flex flex-col justify-between h-52 hover:bg-[#003366] transition-all group snap-start min-w-[50%] md:min-w-[25%] block">
              
              <div class="w-12 h-12 text-gray-400 grayscale group-hover:grayscale-0 group-hover:text-black transition-all" set:html={item.svg} />
              
              <div class="flex justify-between items-end text-left">
                <span class="text-sm font-black text-gray-700 group-hover:text-black uppercase tracking-tight leading-tight w-2/3 block">
                  {t(`ind.${item.key}`)}
                </span>
                <span class="text-gray-300 group-hover:text-black transition-all text-xl">→</span>
              </div>
            </a>
          ))}
        </div>
        <div class="flex justify-center gap-4 mt-12">
          <button id="ind-prev" class="slider-arrow">←</button>
          <button id="ind-next" class="slider-arrow">→</button>
        </div>
      </div>
    </section>

    <section class="py-24 border-t border-gray-100 bg-white">
      <div class="max-w-7xl mx-auto px-6 text-left">
        <h2 class="text-[36px] font-black text-[#111] mb-20 tracking-tighter text-left">Feature Stories</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-16 mb-20">
          {featureStories.map(f => (
            <a href={`${paths.news}/${f.id}`} class="group cursor-pointer block text-left">
              <div class="aspect-[16/10] rounded-2xl overflow-hidden mb-8 shadow-md">
                <img src={f.img} class="w-full h-full object-cover group-hover:grayscale-0 transition-all duration-700 group-hover:scale-105" alt={t(f.key)} />
              </div>
              <p class="text-[17px] font-black text-gray-900 leading-snug mb-4 group-hover:text-[#ee5931] transition-colors line-clamp-3 text-left">
                {t(f.key)}
              </p>
              <span class="text-xs text-gray-400 font-bold tracking-widest uppercase block text-left">{f.date}</span>
            </a>
          ))}
        </div>
        <div class="flex justify-center">
          <a href={paths.news} class="px-16 py-4 border-2 border-gray-100 text-gray-400 font-black uppercase text-[12px] tracking-[0.3em] hover:bg-[#111] hover:text-white transition-all active:scale-95">
            {t('home.more_btn') || 'XEM THÊM +'}
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
  #ind-slider { cursor: grab; }
  
  .pillar-card { will-change: flex; text-decoration: none; }
  .pillar-card:not(:hover) h3 { font-size: 26px; opacity: 0.7; }

  .slider-arrow {
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    border: 1px solid #e5e7eb;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    background: white;
    cursor: pointer;
    font-size: 1.25rem;
  }
  .slider-arrow:hover { background: #111; color: white; border-color: #111; }
  .slider-arrow:active { transform: scale(0.9); }

  @media (max-width: 768px) {
    .flex { height: auto !important; gap: 20px !important; }
    .pillar-card { height: 400px !important; flex: none !important; }
  }
</style>

<script>
  function initSlider(sliderId: string, prevId: string, nextId: string) {
    const slider = document.getElementById(sliderId);
    const prev = document.getElementById(prevId);
    const next = document.getElementById(nextId);

    if (slider && prev && next) {
      const scrollStep = 350;
      next.onclick = () => {
        slider.scrollBy({ left: scrollStep, behavior: 'smooth' });
      };
      prev.onclick = () => {
        slider.scrollBy({ left: -scrollStep, behavior: 'smooth' });
      };
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    initSlider('ind-slider', 'ind-prev', 'ind-next');
  });
</script>