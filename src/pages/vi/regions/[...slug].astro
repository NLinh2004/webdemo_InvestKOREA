---
import Layout from '../../../layouts/Layout.astro';
import ComingSoon from '../../../components/ComingSoon.astro';

export function getStaticPaths() {
  return [
    { params: { slug: 'invest-report' } },
  ];
}

const { slug } = Astro.params;
const lang = 'vi';

const sectionTitle = slug === 'invest-report' ? 'Báo cáo đầu tư khu vực' : 'Thông tin khu vực';
---

<Layout title={`${sectionTitle} - Invest KOREA`} lang={lang}>
  <main class="bg-white">
    <ComingSoon lang={lang} section={sectionTitle} />
  </main>
</Layout>
