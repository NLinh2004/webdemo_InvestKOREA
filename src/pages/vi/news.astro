---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'vi';
const t = useTranslations(lang);

// Danh sách tin tức đầy đủ (Bạn có thể map từ file i18n của mình)
const allNews = [
  { id: 'f1', date: '2025.12.04', key: 'home.feat_1' },
  { id: 'f2', date: '2025.11.07', key: 'home.feat_2' },
  { id: 'f3', date: '2025.10.01', key: 'home.feat_3' },
  { id: 'm-name', date: '2025.09.15', key: 'home.success_m_name' },
  { id: 'e-name', date: '2025.08.20', key: 'home.success_e_name' }
];
---

<Layout title="Tin tức & Sự kiện | Invest KOREA" lang={lang}>
  <main class="bg-white antialiased">
    <section class="pt-32 pb-16 bg-gray-50 border-b border-gray-100">
      <div class="container mx-auto px-6 max-w-7xl">
        <h1 class="text-5xl font-black text-[#003366] tracking-tighter uppercase not-italic">
          {t('home.feature_title')}
        </h1>
      </div>
    </section>

    <section class="py-20">
      <div class="container mx-auto px-6 max-w-7xl">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
          {allNews.map(item => (
            <a href={`/vi/news/${item.id}`} class="group block text-left">
              <div class="aspect-video rounded-2xl overflow-hidden mb-6 bg-gray-100 shadow-sm">
                <img 
                  src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab" 
                  class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" 
                  alt={t(item.key)}
                />
              </div>
              <span class="text-xs text-[#ee5931] font-bold uppercase tracking-widest mb-3 block italic">
                {item.date}
              </span>
              <h2 class="text-xl font-black text-[#111] leading-tight mb-4 group-hover:text-[#ee5931] transition-colors line-clamp-2 not-italic">
                {t(item.key)}
              </h2>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  main * { font-style: normal !important; letter-spacing: -0.015em; }
</style>