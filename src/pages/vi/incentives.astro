---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../i18n/utils';
const lang = 'vi'; 
const t = useTranslations(lang);
---

<Layout title={t('inc.title')} lang={lang}>
  <main class="bg-white min-h-screen">
    <div class="border-b border-gray-100 py-4">
      <div class="max-w-7xl mx-auto px-6 text-[12px] font-bold text-gray-400 uppercase tracking-widest">
        Home <span class="mx-2">/</span> {t('inc.title')}
      </div>
    </div>

    <section class="max-w-7xl mx-auto px-6 py-28 flex flex-col lg:flex-row gap-20">
      <div class="lg:w-1/3 border-r border-gray-100">
        <h1 class="text-[64px] font-black text-[#111] leading-none tracking-tighter uppercase italic">
          Incentives
        </h1>
      </div>

      <div class="lg:w-2/3 pt-6">
        <div class="group cursor-pointer">
          <h3 class="text-[20px] font-black text-gray-900 uppercase group-hover:text-[#ee5931] transition-colors">
            {t('inc.policy')}
          </h3>
          <div class="w-12 h-1 bg-[#ee5931] mt-2"></div>
        </div>
      </div>
    </section>
  </main>
</Layout>